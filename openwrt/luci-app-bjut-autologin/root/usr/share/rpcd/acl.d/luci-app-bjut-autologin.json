{
  "luci-app-bjut-autologin": {
    "description": "Grant access to BJUT Auto Login configuration and status",
    "read": {
      "file": {
        "/var/run/bjut-autologin/status.json": [
          "read"
        ]
      },
      "uci": [
        "bjut-autologin"
      ],
      "ubus": {
        "bjut-autologin": [
          "status",
          "accounts",
          "ports",
          "logs",
          "settings",
          "billing_cached",
          "maintenance_info",
          "maintenance_poll",
          "billing_poll",
          "dashboard"
        ]
      }
    },
    "write": {
      "uci": [
        "bjut-autologin"
      ],
      "ubus": {
        "bjut-autologin": [
          "login",
          "account_set",
          "billing_start",
          "billing_captcha",
          "save_settings",
          "maintenance_start",
          "pushplus_test",
          "account_save",
          "account_delete",
          "account_move",
          "uplink_save",
          "uplink_delete",
          "billing_records",
          "logout",
          "switch_account",
          "billing_details",
          "billing_action"
        ]
      }
    }
  }
}
