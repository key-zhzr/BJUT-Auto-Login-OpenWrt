{
  "luci-app-bjut-autologin": {
    "description": "Grant access to BJUT Auto Login configuration and status",
    "read": {
      "file": {
        "/var/run/bjut-autologin/status.json": [
          "read"
        ]
      },
      "uci": [
        "bjut-autologin"
      ],
      "ubus": {
        "bjut-autologin": [
          "status",
          "accounts",
          "ports",
          "logs",
          "settings",
          "billing_poll"
        ]
      }
    },
    "write": {
      "uci": [
        "bjut-autologin"
      ],
      "ubus": {
        "bjut-autologin": [
          "login",
          "account_set",
          "billing_start",
          "billing_captcha"
        ]
      }
    }
  }
}
