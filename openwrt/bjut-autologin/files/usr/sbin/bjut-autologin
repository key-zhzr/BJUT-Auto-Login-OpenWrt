#!/bin/sh
# SPDX-License-Identifier: MIT

# The daemon intentionally uses only one sleeping BusyBox ash process while
# idle. curl and the tiny codec helper are started only for a connectivity
# check or portal exchange.

VERSION="0.1.6"
TAG="bjut-autologin"

FUNCTIONS_SH="${BJUT_FUNCTIONS_SH:-/lib/functions.sh}"
JSHN_SH="${BJUT_JSHN_SH:-/usr/share/libubox/jshn.sh}"
CURL_BIN="${BJUT_CURL:-/usr/bin/curl}"
JSONFILTER_BIN="${BJUT_JSONFILTER:-/usr/bin/jsonfilter}"
UBUS_BIN="${BJUT_UBUS:-/bin/ubus}"
IWINFO_BIN="${BJUT_IWINFO:-/usr/bin/iwinfo}"
IP_BIN="${BJUT_IP:-/sbin/ip}"
CODEC_BIN="${BJUT_CODEC:-/usr/libexec/bjut-codec}"
LOGGER_BIN="${BJUT_LOGGER:-/usr/bin/logger}"
SYS_NET="${BJUT_SYS_NET:-/sys/class/net}"
STATE_DIR="${BJUT_STATE_DIR:-/var/run/bjut-autologin}"
STATE_FILE="$STATE_DIR/status.json"
LOCK_DIR="$STATE_DIR/lock"

CONFIG_PACKAGE="${BJUT_CONFIG_PACKAGE:-bjut-autologin}"
DORM_GATEWAY="10.21.221.98"
WIFI_GATEWAY="10.21.251.3"
LGN_GATEWAY_PRIMARY="172.30.201.2"
LGN_GATEWAY_SECONDARY="172.30.201.10"
DORM_SPKI_PIN="sha256//9YYIa+Z8Ae4Y8ipQSZXowtxC1CZv/pvXvKuT7eUIXyg="
MAX_RESPONSE_BYTES=131072

SELF_BIN="${BJUT_SELF:-$0}"
UCI_BIN="${BJUT_UCI:-/sbin/uci}"
MWAN_WRAPPER="${BJUT_MWAN_WRAPPER:-/lib/mwan3/libwrap_mwan3_sockopt.so.1.0}"
LIB_DIR="${BJUT_LIB_DIR:-/usr/lib/bjut-autologin}"
CURL_IFHOST=""
UPLINK_SECTIONS=""
UPLINK_CONFIGURED=0
UPLINK_ID=main
DEVICE6=""
LOCAL_IPV6=""
NETWORK_JSON4=""
NETWORK_JSON6=""
ROUTE4=unknown
ROUTE6=unknown
PROBE4=unknown
PROBE6=unknown
SESSION_STATE=unknown
MANUAL_ACCOUNT=""
MANUAL_ACTION=login
OPERATION_ID=''
CONFIG_LOADED=0
MAIN_SECTION=""
ACCOUNT_SECTIONS=""
WORK_DIR=""
LOCK_HELD=0
SLEEP_PID=""
CHILD_PIDS=""
SOURCE_LOCK=""
SOURCE_STATE=""
SOURCE_LOCK_HELD=0
EVENT="periodic"
FORCE=0

DEVICE=""
LOCAL_IPV4=""
TRANSPORT="unknown"
SSID=""
BSSID=""
HTTP_CODE="000"
HTTP_BODY=""
SELECTED_PROTOCOL=""
SELECTED_ACCOUNT=""
TYPE1_TLS_HOST=""
TYPE1_TLS_PROFILE=""
OBSERVED_IPV6=""
OBSERVED_ACCOUNT=""
VERIFIED_PROTOCOL=""
VERIFIED_AT=0
VERIFIED_IDENTITY=""

RUNTIME_FAILURES=0
RUNTIME_OFFLINE_COUNT=0
RUNTIME_NEXT_ATTEMPT=0

cleanup_runtime() {
	[ "$LOCK_HELD" != 1 ] || rm -f -- "$STATE_DIR/phase-$UPLINK_ID"
	if [ "$SOURCE_LOCK_HELD" = 1 ]; then rm -rf -- "$SOURCE_LOCK"; fi
	SOURCE_LOCK_HELD=0
	if [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ]; then
		rm -rf -- "$WORK_DIR"
	fi
	WORK_DIR=""
	if [ "$LOCK_HELD" = "1" ] && [ -d "$LOCK_DIR" ]; then
		rm -rf -- "$LOCK_DIR"
	fi
	LOCK_HELD=0
}

handle_signal() {
	[ -z "$SLEEP_PID" ] || kill "$SLEEP_PID" 2>/dev/null || true
	for child in $CHILD_PIDS; do kill "$child" 2>/dev/null || true; done
	cleanup_runtime
	exit 143
}

trap cleanup_runtime 0
trap handle_signal 1 2 15
umask 077
set -f

usage() {
	cat <<'EOF'
Usage: bjut-autologin COMMAND

Commands:
  daemon          run the low-overhead periodic service (for procd)
  once            perform one normal check, respecting cooldowns
  manual [uplink] [account]  check/login one uplink now
  once [uplink]   check one uplink or all configured uplinks
  status [uplink] print one uplink or the combined runtime status
  status          print the current runtime status as JSON
  check-config    validate dependencies and UCI configuration
  version         print the OpenWrt port version
EOF
}

command_exists() {
	[ -x "$1" ]
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_range() {
	is_uint "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

valid_device_name() {
	case "$1" in
		''|*[!A-Za-z0-9_.:@-]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_http_url() {
	case "$1" in
		http://*|https://*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*'"'*|*'\'*|*' '*|*'	'*|*'
'*) return 1 ;;
		*) return 0 ;;
	esac
}

normalize_bssid() {
	printf '%s' "$1" | tr 'A-F-' 'a-f:'
}

valid_bssid() {
	local value first
	value="$(normalize_bssid "$1")"
	case "$value" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
		*) return 1 ;;
	esac
	[ "$value" != "00:00:00:00:00:00" ] || return 1
	[ "$value" != "ff:ff:ff:ff:ff:ff" ] || return 1
	[ "$value" != "02:00:00:00:00:00" ] || return 1
	first="${value%%:*}"
	# Multicast BSSIDs have the low bit set. The explicitly enumerated values
	# keep this test portable without shell hexadecimal arithmetic.
	case "$first" in
		01|03|05|07|09|0b|0d|0f|11|13|15|17|19|1b|1d|1f|21|23|25|27|29|2b|2d|2f|31|33|35|37|39|3b|3d|3f|41|43|45|47|49|4b|4d|4f|51|53|55|57|59|5b|5d|5f|61|63|65|67|69|6b|6d|6f|71|73|75|77|79|7b|7d|7f|81|83|85|87|89|8b|8d|8f|91|93|95|97|99|9b|9d|9f|a1|a3|a5|a7|a9|ab|ad|af|b1|b3|b5|b7|b9|bb|bd|bf|c1|c3|c5|c7|c9|cb|cd|cf|d1|d3|d5|d7|d9|db|dd|df|e1|e3|e5|e7|e9|eb|ed|ef|f1|f3|f5|f7|f9|fb|fd|ff) return 1 ;;
	esac
	return 0
}

is_campus_ipv4() {
	local old_ifs a b c d
	old_ifs="$IFS"
	IFS=.
	set -- $1
	IFS="$old_ifs"
	[ "$#" -eq 4 ] || return 1
	a="$1"; b="$2"; c="$3"; d="$4"
	for octet in "$a" "$b" "$c" "$d"; do
		is_uint "$octet" || return 1
		[ "$octet" -le 255 ] || return 1
	done
	case "$a:$b" in
		10:1[7-9]|10:2[0-7]|10:121|10:126|10:226|172:1[7-9]|172:2[0-7]|172:30) return 0 ;;
		*) return 1 ;;
	esac
}

normalize_ssid() {
	printf '%s' "$1" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ_' 'abcdefghijklmnopqrstuvwxyz-' | sed 's/--*/-/g'
}

valid_ap_id() {
	[ "${#1}" -eq 4 ] || return 1
	case "$1" in
		*[!A-Za-z0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

known_dorm_ssid() {
	local value prefix suffix stem marker candidate
	value="$(normalize_ssid "$1")"
	[ "$value" = "bjut-sushe" ] && return 0
	case "$value" in
		cu-bjut-sushe-*-5g)
			stem="${value%-5g}"; suffix="${stem##*-}"; valid_ap_id "$suffix" && return 0 ;;
		cu-bjut-sushe-*)
			suffix="${value##*-}"; valid_ap_id "$suffix" && return 0 ;;
	esac
	for prefix in bjut-sushe bjutsushe bj-sushe bjit-sushe bjur-sushe bjut-suahe bjut-sudhe bjut-suhe bjut-sushr bjuy-sushe bnut-sushe; do
		case "$value" in "$prefix"*) suffix="${value#"$prefix"}" ;; *) continue ;; esac
		for marker in -2.4g- -5g- 2.4g- 5g- -2.4-; do
			case "$suffix" in
				"$marker"*) candidate="${suffix#"$marker"}"; valid_ap_id "$candidate" && return 0 ;;
			esac
		done
	done
	return 1
}

known_public_ssid() {
	[ "$(normalize_ssid "$1")" = "bjut-wifi" ]
}

mask_username() {
    printf '%s' "$1"
}

protocol_name() {
    case "$1" in type1|bjut-sushe) printf 'bjut-sushe';; type2|bjut_wifi) printf 'bjut_wifi';; type3|lgn) printf 'lgn';; *) printf '%s' "$1";; esac
}

protocol_internal() {
    case "$1" in bjut-sushe) printf 'type1';; bjut_wifi) printf 'type2';; lgn) printf 'type3';; *) printf '%s' "$1";; esac
}

log_message() {
	bjut_log_message "$1" "$2"
}

load_main_section() {
	[ -z "$MAIN_SECTION" ] || return 0
	MAIN_SECTION="$1"
	config_get_bool CFG_ENABLED "$1" enabled 0
	config_get CFG_NETWORK "$1" network "wwan"
	config_get CFG_DEVICE "$1" device ""
	config_get CFG_NETWORK6 "$1" network6 ""
	config_get CFG_DEVICE6 "$1" device6 ""
	config_get CFG_SOURCE4 "$1" source4 ""
	config_get CFG_SOURCE6 "$1" source6 ""
	config_get CFG_ACCOUNT_ORDER "$1" accounts ""
	config_get_bool CFG_MWAN3 "$1" mwan3 1
	config_get_bool CFG_MANAGED_ROUTES "$1" managed_routes 1
	config_get CFG_TRANSPORT "$1" transport "auto"
	config_get CFG_LOGIN_TYPE "$1" login_type "auto"
	CFG_LOGIN_TYPE="$(protocol_internal "$CFG_LOGIN_TYPE")"
	config_get CFG_COMPATIBILITY "$1" compatibility "secure"
	config_get CFG_INTERVAL "$1" interval "20"
	config_get CFG_TIMEOUT "$1" timeout "3"
	config_get CFG_OFFLINE_CONFIRMATIONS "$1" offline_confirmations "2"
	config_get CFG_MAX_BACKOFF "$1" max_backoff "300"
	config_get CFG_CREDENTIAL_COOLDOWN "$1" credential_cooldown "600"
	config_get CFG_POST_LOGIN_DELAY "$1" post_login_delay "2"
	config_get CFG_ONLINE_URL "$1" online_url "http://connect.rom.miui.com/generate_204"
	config_get CFG_ONLINE_CODE "$1" online_code "204"
	config_get_bool CFG_STRICT_NETWORK "$1" strict_network 1
	config_get CFG_EXPECTED_SSID "$1" expected_ssid ""
	config_get CFG_EXPECTED_BSSID "$1" expected_bssid ""
	config_get CFG_LOG_LEVEL "$1" log_level "info"
	config_get CFG_LOG_TARGET "$1" log_target system
	config_get CFG_LOG_DIRECTORY "$1" log_directory /tmp/bjut-autologin-log
	config_get_bool CFG_LOG_WEB "$1" log_web 0
	config_get CFG_LOG_MAX_KB "$1" log_max_kb 256
	config_get_bool CFG_PUSHPLUS_ENABLED "$1" pushplus_enabled 0
	config_get CFG_PUSHPLUS_TOKEN "$1" pushplus_token ""
	config_get CFG_PUSHPLUS_TOPIC "$1" pushplus_topic ""
	config_get_bool CFG_PUSHPLUS_ONLINE "$1" pushplus_online 1
	config_get_bool CFG_PUSHPLUS_FAILURE "$1" pushplus_failure 1
	config_get CFG_PUSHPLUS_DELAY "$1" pushplus_delay 60
	config_get CFG_PUSHPLUS_INTERVAL "$1" pushplus_interval 3600
	config_get_bool CFG_BILLING_BACKGROUND "$1" billing_background 0
	config_get_bool CFG_TRAFFIC_MONITOR "$1" traffic_monitor 0
	config_get CFG_TRAFFIC_SCOPE "$1" traffic_scope ""
	case "$CFG_TRAFFIC_SCOPE" in local|all) ;; *) CFG_TRAFFIC_MONITOR=0; CFG_TRAFFIC_SCOPE=local;; esac
	config_get_bool CFG_PREFER_FLOW "$1" prefer_remaining_flow 0
	config_get CFG_BILLING_INTERVAL "$1" billing_interval 21600
	config_get_bool CFG_BILLING_ALERTS "$1" billing_alerts 1
	config_get CFG_BALANCE_THRESHOLD "$1" balance_threshold 5
	config_get CFG_FLOW_THRESHOLD "$1" flow_threshold 5
}

collect_account_section() {
	local enabled
	config_get_bool enabled "$1" enabled 1
	ACCOUNT_SECTIONS="${ACCOUNT_SECTIONS}${ACCOUNT_SECTIONS:+ }$1"
}

load_configuration() {
	[ "$CONFIG_LOADED" = "1" ] && return 0
	[ -r "$FUNCTIONS_SH" ] || {
		printf 'Missing OpenWrt shell library: %s\n' "$FUNCTIONS_SH" >&2
		return 1
	}
	. "$FUNCTIONS_SH"
	config_load "$CONFIG_PACKAGE" || {
		printf 'Unable to load /etc/config/%s\n' "$CONFIG_PACKAGE" >&2
		return 1
	}
	config_foreach load_main_section service
	[ -n "$MAIN_SECTION" ] || {
		printf 'Missing service section in /etc/config/%s\n' "$CONFIG_PACKAGE" >&2
		return 1
	}
	config_foreach collect_account_section account
	config_foreach collect_uplink_section uplink
	[ "$UPLINK_CONFIGURED" = 1 ] || UPLINK_SECTIONS=main
	CONFIG_LOADED=1
	return 0
}

validate_configuration() {
	local section username password protocol enabled usable_accounts=0
	load_configuration || return 1
	for dependency in "$CURL_BIN" "$JSONFILTER_BIN" "$UBUS_BIN" "$CODEC_BIN"; do
		command_exists "$dependency" || {
			printf 'Required executable is missing: %s\n' "$dependency" >&2
			return 1
		}
	done
	[ -r "$JSHN_SH" ] || {
		printf 'Required jshn library is missing: %s\n' "$JSHN_SH" >&2
		return 1
	}
	case "$CFG_TRANSPORT" in auto|wifi|ethernet) ;; *) printf 'Invalid transport: %s\n' "$CFG_TRANSPORT" >&2; return 1 ;; esac
	case "$CFG_LOGIN_TYPE" in auto|type1|type2|type3) ;; *) printf 'Invalid login_type: %s\n' "$CFG_LOGIN_TYPE" >&2; return 1 ;; esac
	case "$CFG_COMPATIBILITY" in secure|legacy_http) ;; *) printf 'Invalid compatibility: %s\n' "$CFG_COMPATIBILITY" >&2; return 1 ;; esac
	case "$CFG_LOG_LEVEL" in trace|debug|info|notice|warning|error) ;; *) printf 'Invalid log_level\n' >&2; return 1 ;; esac
	case "$CFG_LOG_TARGET" in system|file) ;; *) printf 'Invalid log_target\n' >&2; return 1;; esac
	valid_log_directory "$CFG_LOG_DIRECTORY" && valid_range "$CFG_LOG_MAX_KB" 64 4096 || { printf 'Invalid log directory or size\n' >&2; return 1; }
	valid_range "$CFG_INTERVAL" 5 3600 || { printf 'interval must be 5..3600 seconds\n' >&2; return 1; }
	valid_range "$CFG_TIMEOUT" 1 30 || { printf 'timeout must be 1..30 seconds\n' >&2; return 1; }
	valid_range "$CFG_OFFLINE_CONFIRMATIONS" 1 10 || { printf 'offline_confirmations must be 1..10\n' >&2; return 1; }
	valid_range "$CFG_MAX_BACKOFF" "$CFG_INTERVAL" 86400 || { printf 'max_backoff must be interval..86400 seconds\n' >&2; return 1; }
	valid_range "$CFG_CREDENTIAL_COOLDOWN" 30 86400 || { printf 'credential_cooldown must be 30..86400 seconds\n' >&2; return 1; }
	valid_range "$CFG_POST_LOGIN_DELAY" 0 15 || { printf 'post_login_delay must be 0..15 seconds\n' >&2; return 1; }
	case "$CFG_ONLINE_CODE" in [1-5][0-9][0-9]) ;; *) printf 'online_code must be a three-digit HTTP status\n' >&2; return 1 ;; esac
	valid_http_url "$CFG_ONLINE_URL" || { printf 'online_url must be one safe HTTP(S) URL\n' >&2; return 1; }
	[ -z "$CFG_DEVICE" ] || valid_device_name "$CFG_DEVICE" || { printf 'Invalid device name\n' >&2; return 1; }
	valid_device_name "$CFG_NETWORK" || { printf 'Invalid network name\n' >&2; return 1; }
	[ -z "$CFG_EXPECTED_BSSID" ] || valid_bssid "$CFG_EXPECTED_BSSID" || { printf 'Invalid expected_bssid\n' >&2; return 1; }
	if [ "$CFG_ENABLED" = "1" ]; then
		[ -n "$CFG_NETWORK" ] || { printf 'network must not be empty\n' >&2; return 1; }
		for section in $ACCOUNT_SECTIONS; do
			config_get username "$section" username ""
			config_get password "$section" password ""
			config_get protocol "$section" login_type "auto"
			protocol="$(protocol_internal "$protocol")"
			case "$protocol" in auto|type1|type2|type3) ;; *) printf 'Invalid account login_type in %s\n' "$section" >&2; return 1 ;; esac
			[ "${#username}" -le 256 ] || { printf 'Account username is too long in %s\n' "$section" >&2; return 1; }
			[ "${#password}" -le 4096 ] || { printf 'Account password is too long in %s\n' "$section" >&2; return 1; }
			[ -n "$username" ] && [ -n "$password" ] && usable_accounts=$((usable_accounts + 1))
			password=""
		done
		[ "$usable_accounts" -gt 0 ] || { printf 'At least one enabled account with username and password is required\n' >&2; return 1; }
	fi
	return 0
}

json_file_value() {
	[ -s "$1" ] || return 0
	"$JSONFILTER_BIN" -i "$1" -e "$2" 2>/dev/null | head -n 1
}

load_runtime_state() {
	local value previous_file="$STATE_FILE" source_time own_time own_state
	source_time="$(json_file_value "$SOURCE_STATE" '@.updated_at')"; own_time="$(json_file_value "$STATE_FILE" '@.updated_at')"
	own_state="$(json_file_value "$STATE_FILE" '@.state')"
	if [ -n "$SOURCE_STATE" ] && [ -s "$SOURCE_STATE" ] && { [ "$(json_file_value "$previous_file" '@.ipv4')" != "$LOCAL_IPV4" ] || [ "$own_state" = busy ] || { is_uint "$source_time" && is_uint "$own_time" && [ "$source_time" -gt "$own_time" ]; }; }; then
		if [ "$(json_file_value "$SOURCE_STATE" '@.ipv4')" = "$LOCAL_IPV4" ] && [ "$(json_file_value "$SOURCE_STATE" '@.device')" = "$DEVICE" ]; then previous_file="$SOURCE_STATE"; fi
	fi
	RUNTIME_FAILURES=0
	RUNTIME_OFFLINE_COUNT=0
	RUNTIME_NEXT_ATTEMPT=0
	RUNTIME_STATE=""
	RUNTIME_IPV4=""
	RUNTIME_ACCOUNT=""
	RUNTIME_PROTOCOL=""
	[ -s "$previous_file" ] || return 0
	value="$(json_file_value "$previous_file" '@.failures')"; is_uint "$value" && RUNTIME_FAILURES="$value"
	value="$(json_file_value "$previous_file" '@.offline_count')"; is_uint "$value" && RUNTIME_OFFLINE_COUNT="$value"
	value="$(json_file_value "$previous_file" '@.next_attempt')"; is_uint "$value" && RUNTIME_NEXT_ATTEMPT="$value"
	RUNTIME_STATE="$(json_file_value "$previous_file" '@.state')"
	RUNTIME_IPV4="$(json_file_value "$previous_file" '@.ipv4')"
	RUNTIME_ACCOUNT="$(json_file_value "$previous_file" '@.account')"
	RUNTIME_PROTOCOL="$(protocol_internal "$(json_file_value "$previous_file" '@.protocol')")"
	if [ "$RUNTIME_IPV4" != "$LOCAL_IPV4" ]; then
		RUNTIME_FAILURES=0; RUNTIME_OFFLINE_COUNT=0; RUNTIME_NEXT_ATTEMPT=0; RUNTIME_STATE=""
		RUNTIME_ACCOUNT=""; RUNTIME_PROTOCOL=""
	fi
}

write_status() {
	local state="$1" message="$2" protocol="$3" account="$4" next_attempt="$5" failures="$6" offline_count="$7"
	local tmp now retry_after="${8:-}"
	mkdir -p "$STATE_DIR" || return 1
	chmod 0700 "$STATE_DIR" 2>/dev/null || return 1
	tmp="$STATE_FILE.$$"
	now="$(date +%s)"
	# Start backoff after network work finishes, not before a slow probe.
	if [ -n "$retry_after" ] && is_uint "$retry_after"; then
		next_attempt=$((now + retry_after))
	fi
	. "$JSHN_SH"
	json_init
	json_add_string id "$UPLINK_ID"
	json_add_string version "$VERSION"
	json_add_string state "$state"
	json_add_string message "$message"
	json_add_int updated_at "$now"
	json_add_string event "$EVENT"
	json_add_string network "$CFG_NETWORK"
	json_add_string device "$DEVICE"
	json_add_string transport "$TRANSPORT"
	json_add_string ipv4 "$LOCAL_IPV4"
	json_add_string network6 "$CFG_NETWORK6"
	json_add_string device6 "$DEVICE6"
	json_add_string ipv6 "$LOCAL_IPV6"
	json_add_string ipv6_pd "${IPV6_PD:-}"
	json_add_string internet4 "$PROBE4"
	json_add_string internet6 "$PROBE6"
	json_add_string session "$SESSION_STATE"
	json_add_string route4 "$ROUTE4"
	json_add_string route6 "$ROUTE6"
	json_add_string ssid "$SSID"
	json_add_string bssid "$BSSID"
	json_add_string protocol "$(protocol_name "$protocol")"
	json_add_string account "$account"
	json_add_int next_attempt "$next_attempt"
	json_add_int failures "$failures"
	json_add_int offline_count "$offline_count"
	json_dump >"$tmp" && mv -f "$tmp" "$STATE_FILE" || return 1
	log_message info "检测完成：${message}；IPv4=${PROBE4}，IPv6=${PROBE6}，会话=$SESSION_STATE${account:+，账号=$account}"
	if [ "$SOURCE_LOCK_HELD" = 1 ]; then cp "$STATE_FILE" "$SOURCE_STATE.$$" && mv -f "$SOURCE_STATE.$$" "$SOURCE_STATE"; fi
	operation_complete "$state" "$message"
	account_release
	pushplus_observe "$state" "$message" "$protocol" "$account" "$now"
}

write_phase() {
	log_message debug "$1"
	operation_update running "$1"
	printf '%s %s\n%s\n' "$$" "$(date +%s)" "$1" >"$STATE_DIR/phase-$UPLINK_ID.$$" &&
		mv -f "$STATE_DIR/phase-$UPLINK_ID.$$" "$STATE_DIR/phase-$UPLINK_ID"
}

print_status_file() (
 local file="$1" section="$2" pid started message="" checking=0 age updated now valid stale=0 operation key value
	. "$JSHN_SH"
	if [ -s "$file" ]; then json_load "$(cat "$file")" || return 1; else
		json_init; json_add_string id "$section"; json_add_string state stopped
		json_add_string message "等待检测"
	fi
	if [ -r "$STATE_DIR/phase-$section" ]; then
		read -r pid started <"$STATE_DIR/phase-$section"
		if is_uint "$pid" && is_uint "$started" && kill -0 "$pid" 2>/dev/null && [ "$(($(date +%s) - started))" -lt 180 ]; then
			checking=1; message="$(sed -n '2p' "$STATE_DIR/phase-$section")"
		fi
	fi
	# Keep the last completed result visible while a new check is running.
	if [ -s "$STATE_DIR/manual-$section" ]; then checking=1; message='操作已排队，即将处理'; fi
	json_add_int checking "$checking"
	json_add_string check_message "$message"
	updated="$(json_file_value "$file" '@.updated_at')"; now="$(date +%s)"; age=0; valid=$(( ${CFG_INTERVAL:-20}*3+30 ))
	if is_uint "$updated" && [ "$now" -ge "$updated" ]; then age=$((now-updated)); [ "$age" -le "$valid" ] || stale=1; else stale=1; fi
	json_add_int age_seconds "$age"; json_add_int stale "$stale"; json_add_int valid_for "$valid"
	operation="$(operation_status "$section")"
	json_add_object operation
	for key in id action account state phase created_at updated_at deadline duration; do
	 value="$(network_json_value "$operation" "@.$key")"; [ -z "$value" ] || json_add_string "$key" "$value"
	done
	json_close_object
	json_dump
)

acquire_lock() {
	local owner
	mkdir -p "$STATE_DIR" || return 1
	chmod 0700 "$STATE_DIR" 2>/dev/null || return 1
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf '%s\n' "$$" >"$LOCK_DIR/pid"
		LOCK_HELD=1
		return 0
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
	if is_uint "$owner" && kill -0 "$owner" 2>/dev/null; then
		return 1
	fi
	if is_uint "$owner"; then
		rm -rf -- "$STATE_DIR/work.$owner" "$STATE_DIR/work.$UPLINK_ID.$owner"
	fi
	rm -rf -- "$LOCK_DIR"
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf '%s\n' "$$" >"$LOCK_DIR/pid"
		LOCK_HELD=1
		return 0
	fi
	return 1
}

release_lock() {
	if [ "$LOCK_HELD" = "1" ]; then
		rm -rf -- "$LOCK_DIR"
	fi
	LOCK_HELD=0
}

prepare_work_dir() {
	WORK_DIR="$STATE_DIR/work.$UPLINK_ID.$$"
	rm -rf -- "$WORK_DIR"
	mkdir -p "$WORK_DIR"
}

network_json_value() {
	printf '%s' "$1" | "$JSONFILTER_BIN" -e "$2" 2>/dev/null | head -n 1
}

read_network_identity() {
	local status up detected_device info
	DEVICE=""; DEVICE6=""; LOCAL_IPV4=""; LOCAL_IPV6=""; TRANSPORT=unknown
	SSID=""; BSSID=""; NETWORK_JSON4=""; NETWORK_JSON6=""
	status="$("$UBUS_BIN" -S call "network.interface.$CFG_NETWORK" status 2>/dev/null)" || status=""
	up="$(network_json_value "$status" '@.up')"
	case "$up" in 1|true) ;; *)
		[ -n "$CFG_NETWORK6" ] || return 1
		status="$("$UBUS_BIN" -S call "network.interface.$CFG_NETWORK6" status 2>/dev/null)" || return 1
		up="$(network_json_value "$status" '@.up')";case "$up" in 1|true) ;; *)return 1;;esac
	;;esac
	NETWORK_JSON4="$status"
	detected_device="$(network_json_value "$status" '@.l3_device')"
	[ -n "$detected_device" ] || detected_device="$(network_json_value "$status" '@.device')"
	DEVICE="${CFG_DEVICE:-$detected_device}"
	valid_device_name "$DEVICE" || return 1
	[ -d "$SYS_NET/$DEVICE" ] || return 1
	LOCAL_IPV4="$(network_json_value "$status" '@["ipv4-address"][0].address')"
	if [ -z "$LOCAL_IPV4" ] && command_exists "$IP_BIN"; then
		LOCAL_IPV4="$("$IP_BIN" -4 -o addr show dev "$DEVICE" scope global 2>/dev/null | awk 'NR == 1 { split($4, value, "/"); print value[1] }')"
	fi
	if [ -n "$CFG_SOURCE4" ]; then
		LOCAL_IPV4="$("$IP_BIN" -4 -o addr show dev "$DEVICE" scope global 2>/dev/null |
			awk -v wanted="$CFG_SOURCE4" '{split($4,a,"/"); if(a[1] == wanted) print a[1]}')"
	fi
	read_ipv6_identity
	if is_campus_ipv4 "$LOCAL_IPV4";then
		if ! "$IP_BIN" -4 -o addr show dev "$DEVICE" scope global 2>/dev/null | awk -v wanted="$LOCAL_IPV4" '{split($4,a,"/"); if(a[1] == wanted) found=1} END{exit !found}';then return 1;fi
	else
		# IPv6-only LGN is permitted only on the observed campus prefix. The
		# normal TLS + protocol probes still run before any credentials.
		case "$(printf '%s' "$LOCAL_IPV6" | tr A-F a-f)" in 2001:da8:216:*) LOCAL_IPV4='';;*)return 2;;esac
	fi

	TRANSPORT="$CFG_TRANSPORT"
	SSID=""
	BSSID=""
	# rpcd-mod-iwinfo works on both classic shell Wi-Fi scripts and newer
	# wifi-scripts-ucode systems where the standalone iwinfo CLI may be absent.
	info="$("$UBUS_BIN" -S call iwinfo info "{\"device\":\"$DEVICE\"}" 2>/dev/null)" || info=""
	if [ -n "$info" ]; then
		SSID="$(network_json_value "$info" '@.ssid')"
		BSSID="$(network_json_value "$info" '@.bssid')"
	fi
	if [ -z "$SSID" ] && command_exists "$IWINFO_BIN"; then
		info="$("$IWINFO_BIN" "$DEVICE" info 2>/dev/null)" || info=""
		SSID="$(printf '%s\n' "$info" | sed -n 's/^.*ESSID: "\(.*\)"/\1/p' | head -n 1)"
		BSSID="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Access Point: \([0-9A-Fa-f:-]*\).*/\1/p' | head -n 1)"
	fi
	BSSID="$(normalize_bssid "$BSSID")"
	if [ "$TRANSPORT" = "auto" ]; then
		if [ -n "$SSID" ] || [ -d "$SYS_NET/$DEVICE/wireless" ]; then
			TRANSPORT="wifi"
		else
			TRANSPORT="ethernet"
		fi
	fi
	return 0
}

validate_network_identity() {
	local protocol="$1" expected_bssid
	case "$protocol:$TRANSPORT" in
		type1:wifi|type1:ethernet|type2:wifi|type3:ethernet) ;;
		*) return 1 ;;
	esac
	# Plain HTTP is never enabled merely because a familiar SSID is visible.
	# On wireless uplinks it additionally requires an exact configured BSSID,
	# even when the optional SSID heuristics below have been disabled.
	if [ "$CFG_COMPATIBILITY" = "legacy_http" ] && [ "$TRANSPORT" = "wifi" ]; then
		[ -n "$CFG_EXPECTED_BSSID" ] || return 1
		valid_bssid "$BSSID" || return 1
		expected_bssid="$(normalize_bssid "$CFG_EXPECTED_BSSID")"
		[ "$BSSID" = "$expected_bssid" ] || return 1
	fi
	[ "$CFG_STRICT_NETWORK" = "1" ] || return 0
	[ "$TRANSPORT" = "wifi" ] || return 0
	valid_bssid "$BSSID" || return 1
	if [ -n "$CFG_EXPECTED_BSSID" ]; then
		expected_bssid="$(normalize_bssid "$CFG_EXPECTED_BSSID")"
		[ "$BSSID" = "$expected_bssid" ] || return 1
	fi
	if [ -n "$CFG_EXPECTED_SSID" ]; then
		[ "$SSID" = "$CFG_EXPECTED_SSID" ] || return 1
	else
		case "$protocol" in
			type1) known_dorm_ssid "$SSID" || return 1 ;;
			type2) known_public_ssid "$SSID" || return 1 ;;
		esac
	fi
	return 0
}

request_id() {
	local now
	now="$(date +%s)"
	printf '%04d' "$(( (now + $$) % 10000 ))"
}

urlencode() {
	printf '%s' "$1" | "$CODEC_BIN" urlencode
}

eportal_encrypt() {
	printf '%s' "$1" | "$CODEC_BIN" eportal
}

base64_value() {
	printf '%s' "$1" | "$CODEC_BIN" base64
}

http_request() {
	local url="$1" referer="$2" resolve="$3" host_header="$4" tls_profile="$5" family="${6:-}"
	local max_time response_size rc
	HTTP_BODY="$WORK_DIR/response"
	: >"$HTTP_BODY"
	max_time="$CFG_TIMEOUT"
	set -- --silent --show-error --output "$HTTP_BODY" --write-out '%{http_code}' \
		--connect-timeout "$CFG_TIMEOUT" --max-time "$max_time" \
		--max-filesize "$MAX_RESPONSE_BYTES" --dump-header "$WORK_DIR/headers" \
		--noproxy '*' --proxy '' --proto '=http,https' \
		--header 'Accept: */*' --header 'Cache-Control: no-cache, no-store' \
		--user-agent "BJUT-Auto-Login-OpenWrt/$VERSION"
	if [ "$family" = ipv6 ]; then set -- "$@" --ipv6; else family=ipv4; set -- "$@" --ipv4; fi
	[ -n "$referer" ] && set -- "$@" --referer "$referer"
	[ -n "$resolve" ] && set -- "$@" --resolve "$resolve"
	[ -n "$host_header" ] && set -- "$@" --header "Host: $host_header"
	if [ "$tls_profile" = "dorm_pinned" ]; then
		set -- "$@" --insecure --pinnedpubkey "$DORM_SPKI_PIN"
	fi
	HTTP_CODE="$(printf 'url = "%s"\n' "$url" | bound_curl "$family" "$@" --config - 2>"$WORK_DIR/curl-error")"
	rc=$?
	log_message trace "网关请求：${family}，HTTP=${HTTP_CODE}，结果=$rc"
	case "$HTTP_CODE" in [0-9][0-9][0-9]) ;; *) HTTP_CODE="000" ;; esac
	[ "$rc" -eq 0 ] || return 1
	response_size="$(wc -c <"$HTTP_BODY" 2>/dev/null | tr -d ' \011\012\015')"
	is_uint "$response_size" || return 1
	[ "$response_size" -le "$MAX_RESPONSE_BYTES" ] || return 1
	return 0
}

http_success() {
	case "$HTTP_CODE" in 2[0-9][0-9]) return 0 ;; *) return 1 ;; esac
}

load_jsonp() {
	local first last
	JSONP_PAYLOAD="$(sed -e '1s/^[^(]*(//' -e '$s/)[^)]*$//' "$HTTP_BODY" 2>/dev/null)"
	first="$(printf '%s' "$JSONP_PAYLOAD" | cut -c1)"
	last="$(printf '%s' "$JSONP_PAYLOAD" | tail -c 1)"
	[ "$first" = "{" ] && [ "$last" = "}" ]
}

jsonp_value() {
	printf '%s' "$JSONP_PAYLOAD" | "$JSONFILTER_BIN" -e "$1" 2>/dev/null | head -n 1
}

response_has_result() {
	local result
	load_jsonp || return 1
	result="$(jsonp_value '@.result')"
	case "$result" in 0|1) return 0 ;; *) return 1 ;; esac
}

parse_login_response() {
	local result message
	LOGIN_FAILURE_MESSAGE=''
	http_success || return 11
	load_jsonp || return 11
	result="$(jsonp_value '@.result')"
	case "$result" in
		1) return 0 ;;
		0)
			LOGIN_FAILURE_MESSAGE="$(jsonp_value '@.msg') $(jsonp_value '@.msga') $(jsonp_value '@.message')"
			message="$(printf '%s' "$LOGIN_FAILURE_MESSAGE" | tr 'A-Z' 'a-z')"
			case "$message" in
				*已经在线*|*已在线*|*already*online*|*has*been*online*|*ip_already_online*|*same*ip*online*) return 13 ;;
				*密码*错误*|*密码*不正确*|*密码*无效*|*password*error*|*password*wrong*|*incorrect*password*|*invalid*password*|*ldap*auth*error*|*userid*error*|*账号*错误*|*账户*错误*|*账号*不存在*|*用户*不存在*|*欠费*|*余额不足*|*停机*|*流量*用尽*|*流量*耗尽*|*流量*用完*|*流量*不足*|*流量*超额*|*流量*超限*|*流量*超出*|*流量*超过*|*超出*流量*|*超过*流量*|*traffic*exceed*|*账号*禁用*|*账户*禁用*|*账号*过期*) return 10 ;;
				*验证码*|*captcha*|*频繁*|*稍后*|*繁忙*|*超时*|*timeout*|*busy*|*try*again*|*temporar*|*rate*limit*|*too*many*requests*|*server*error*|*service*unavailable*|*network*error*|*invalid*request*|*invalid*parameter*|*ip*锁定*|*ip*lock*|*系统*错误*|*系统*异常*|*系统*故障*|*服务器*错误*|*服务器*异常*|*服务器*故障*|*服务*不可用*|*参数*) return 11 ;;
				# A valid result=0 explicitly rejects this submission, including
				# opaque RADIUS codes. Missing, unknown and malformed results still
				# stop traversal, as do environmental/challenge failures above.
				*) return 10 ;;
			esac ;;
		*) return 11 ;;
	esac
}

login_failure_message() {
	# Credentials are provided through the shell's builtin printf, never argv
	# or an environment variable. Only a bounded, single-line reason is logged.
	printf '%s\n' "$1" "$2" "$3" | awk '
	 function hide(s,key,at,out){out="";if(key=="")return s;while((at=index(s,key))>0){out=out substr(s,1,at-1) "[已隐藏]";s=substr(s,at+length(key))}return out s}
	 NR==1{user=$0;next} NR==2{secret=$0;next}
	 {line=hide(hide($0,secret),user);gsub(/[\001-\037\177]/," ",line);out=out " " line}
	 END{gsub(/ +/," ",out);sub(/^ /,"",out);sub(/ $/,"",out);if(length(out)>240)print "网关返回了较长的拒绝说明";else print out}'
}


type1_probe_url() {
	local base="$1" encoded_ip
	encoded_ip="$(base64_value "$LOCAL_IPV4")" || return 1
	encoded_ip="$(urlencode "$encoded_ip")" || return 1
	printf '%s?callback=dr1001&program_index=&wlan_vlan_id=0&wlan_user_ip=%s&wlan_user_ipv6=&wlan_user_ssid=&wlan_user_areaid=&wlan_ac_ip=&wlan_ap_mac=000000000000&gw_id=000000000000&jsVersion=4.X&v=%s&lang=zh' \
		"$base" "$encoded_ip" "$(request_id)"
}

type1_probe_body_valid() {
	local code data
	http_success || return 1
	load_jsonp || return 1
	code="$(jsonp_value '@.code')"
	data="$(jsonp_value '@.data')"
	[ "$code" = "1" ] && [ -n "$data" ]
}

probe_type1_secure_host() {
	local host="$1" profile="$2" base url
	base="https://$host:802/eportal/portal/page/loadConfig"
	url="$(type1_probe_url "$base")" || return 1
	http_request "$url" "https://$DORM_GATEWAY:802/" "$host:802:$DORM_GATEWAY" "$DORM_GATEWAY:802" "$profile" || return 1
	type1_probe_body_valid || return 1
	TYPE1_TLS_HOST="$host"
	TYPE1_TLS_PROFILE="$profile"
	return 0
}

probe_type1_http() {
	local url
	url="$(type1_probe_url "http://$DORM_GATEWAY:801/eportal/portal/page/loadConfig")" || return 1
	http_request "$url" "http://$DORM_GATEWAY/" "" "" "http" || return 1
	type1_probe_body_valid
}

probe_type1() {
	local host
	TYPE1_TLS_HOST=""
	TYPE1_TLS_PROFILE=""
	if [ "$CFG_COMPATIBILITY" = "legacy_http" ]; then
		probe_type1_http
		return $?
	fi
	for host in wlgn.bjut.edu.cn lgn.bjut.edu.cn; do
		probe_type1_secure_host "$host" strict && return 0
		probe_type1_secure_host "$host" dorm_pinned && return 0
	done
	# A read-only HTTP probe may explain the failure but never authorizes an
	# HTTPS-configured credential request. Return 2 for "portal only".
	probe_type1_http && return 2
	return 1
}

probe_type2() {
	local base referer resolve url
	if [ "$CFG_COMPATIBILITY" = "legacy_http" ]; then
		base="http://$WIFI_GATEWAY/drcom/chkstatus"
		referer="http://$WIFI_GATEWAY/"
		resolve=""
	else
		base="https://wlgn.bjut.edu.cn/drcom/chkstatus"
		referer="https://wlgn.bjut.edu.cn/"
		resolve="wlgn.bjut.edu.cn:443:$WIFI_GATEWAY"
	fi
	url="$base?callback=dr1002&jsVersion=4.1&v=$(request_id)&lang=zh"
	http_request "$url" "$referer" "$resolve" "" "strict" || return 1
	http_success && response_has_result
}

lgn_request() {
	local url="$1" host="$2" port="$3" referer="$4" gateway
	if [ "$host" = "lgn6.bjut.edu.cn" ] || [ -z "$LOCAL_IPV4" ]; then
		for gateway in '2001:da8:216:30c9::2' '2001:da8:216:30c9::a'; do
			if http_request "$url" "$referer" "$host:$port:[$gateway]" "" "strict" ipv6 && http_success;then
				[ "$host" = lgn6.bjut.edu.cn ] || { LGN_SELECTED_GATEWAY="[$gateway]";LGN_SELECTED_FAMILY=ipv6; };return 0
			fi
		done
	else
		for gateway in "$LGN_GATEWAY_PRIMARY" "$LGN_GATEWAY_SECONDARY"; do
			if http_request "$url" "$referer" "$host:$port:$gateway" "" "strict" && http_success; then
				LGN_SELECTED_GATEWAY="$gateway";LGN_SELECTED_FAMILY=ipv4
				return 0
			fi
		done
	fi
	return 1
}

lgn_user_info_probe() {
	local url code info labels
	url="https://lgn.bjut.edu.cn:802/eportal/portal/page/loadUserInfo?callback=726427262624&lang=6c7e3b7578&program_index=79225954737327212323222f212e2723&page_index=755e577b7c4e27212323222f212e2320&user_account=&wlan_user_ip=&wlan_user_ipv6=&wlan_user_mac=262626262626262626262626&jsVersion=22384e&encrypt=1&v=$(request_id)&lang=zh"
	lgn_request "$url" "lgn.bjut.edu.cn" 802 "https://lgn.bjut.edu.cn/" || return 1
	load_jsonp || return 1
	code="$(jsonp_value '@.code')"
	info="$(jsonp_value '@.user_info')"
	labels="$(jsonp_value '@.user_info_lang')"
	[ -n "$code" ] && { [ -n "$info" ] || [ -n "$labels" ]; }
}

discover_lgn_ipv6() {
	local url result address
	url="https://lgn6.bjut.edu.cn/drcom/getipv6?callback=dr1004&program_index=o4OBee1755497815&page_index=cHAmjX1755497856&jsVersion=4.2.2&v=$(request_id)&lang=zh"
	lgn_request "$url" "lgn6.bjut.edu.cn" 443 "https://lgn.bjut.edu.cn/" || return 1
	load_jsonp || return 1
	result="$(jsonp_value '@.result')"
	address="$(jsonp_value '@.ip')"
	[ "$result" = "1" ] || return 1
	printf '%s' "$address" | "$CODEC_BIN" validate-ipv6 >/dev/null 2>&1 || return 1
	case "$(printf '%s' "$address" | tr 'A-F' 'a-f')" in 2001:da8:216:*) ;; *) return 1 ;; esac
	OBSERVED_IPV6="$address"
	return 0
}

lgn_landing_probe() {
	local url="https://lgn.bjut.edu.cn/" count=0 location normalized
	while [ "$count" -lt 4 ]; do
		if lgn_request "$url" "lgn.bjut.edu.cn" 443 "https://lgn.bjut.edu.cn/"; then
			normalized="$(tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' <"$HTTP_BODY" | tr -d ' \011\012\015')"
			case "$normalized" in *dr.comwebloginid_*authuserfield*|*authuserfield*dr.comwebloginid_*) return 0 ;; esac
			case "$normalized" in *name=\"v6ip\"*|*name=\'v6ip\'*) return 0 ;; esac
			return 1
		fi
		case "$HTTP_CODE" in 301|302|303) ;; *) return 1 ;; esac
		location="$(sed -n 's/^[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:[[:space:]]*//p' "$WORK_DIR/headers" | tr -d '\r' | tail -n 1)"
		case "$location" in
			/*) case "$location" in //*) return 1 ;; esac; url="https://lgn.bjut.edu.cn$location" ;;
			https://lgn.bjut.edu.cn/*) url="$location" ;;
			http://lgn.bjut.edu.cn/*) url="https://lgn.bjut.edu.cn/${location#http://lgn.bjut.edu.cn/}" ;;
			*) return 1 ;;
		esac
		valid_http_url "$url" || return 1
		count=$((count + 1))
	done
	return 1
}

probe_type3() {
	# Pre-authentication landing fingerprint; account information is separate.
	lgn_landing_probe && return 0
	lgn_user_info_probe
}

probe_protocol() {
	case "$1" in
		type1) probe_type1 ;;
		type2) probe_type2 ;;
		type3) probe_type3 ;;
		*) return 1 ;;
	esac
}

detect_protocol() {
	local candidates candidate rc portal_only=""
	if [ -z "$LOCAL_IPV4" ];then
		[ "$CFG_LOGIN_TYPE" = auto ] || [ "$CFG_LOGIN_TYPE" = type3 ] || return 1
		probe_type3 && { SELECTED_PROTOCOL=type3;VERIFIED_PROTOCOL=type3;VERIFIED_AT="$(date +%s)";VERIFIED_IDENTITY="$(portal_identity_signature)";return 0; };return 1
	fi
	if [ "$CFG_LOGIN_TYPE" != "auto" ]; then
		candidates="$CFG_LOGIN_TYPE"
	elif [ "$TRANSPORT" = "ethernet" ]; then
		case "$LOCAL_IPV4" in 172.26.*) candidates="type3 type1" ;; *) candidates="type1 type3" ;; esac
	elif known_public_ssid "$SSID"; then
		candidates="type2 type1"
	else
		candidates="type1 type2"
	fi
	if [ "$CFG_LOGIN_TYPE" = auto ]; then
		case "$RUNTIME_PROTOCOL" in type1|type2|type3) candidates="$RUNTIME_PROTOCOL $(printf '%s' "$candidates" | sed "s/$RUNTIME_PROTOCOL//g")";; esac
	fi
	for candidate in $candidates; do
		probe_protocol "$candidate"
		rc=$?
		if [ "$rc" -eq 0 ]; then
			SELECTED_PROTOCOL="$candidate"
			VERIFIED_PROTOCOL="$candidate"; VERIFIED_AT="$(date +%s)"
			VERIFIED_IDENTITY="$(portal_identity_signature)"
			return 0
		fi
		[ "$rc" -eq 2 ] && [ -z "$portal_only" ] && portal_only="$candidate"
	done
	[ -n "$portal_only" ] && return 2
	return 1
}

type1_login() {
	local username="$1" password="$2" account encoded_ipv6 encoded_account encoded_password encoded_ip base referer resolve host_header profile url
	case "$(printf '%s' "$username" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" in
		*@campus) account="$username" ;;
		*) account="$username@campus" ;;
	esac
	encoded_account="$(urlencode "$account")" || return 11
	encoded_password="$(urlencode "$password")" || return 11
	encoded_ip="$(urlencode "$LOCAL_IPV4")" || return 11
	if [ "$CFG_COMPATIBILITY" = "legacy_http" ]; then
		base="http://$DORM_GATEWAY:801/eportal/portal/login"
		referer="http://$DORM_GATEWAY/"
		resolve=""; host_header=""; profile="http"
	else
		[ -n "$TYPE1_TLS_HOST" ] || return 11
		base="https://$TYPE1_TLS_HOST:802/eportal/portal/login"
		referer="https://$DORM_GATEWAY:802/"
		resolve="$TYPE1_TLS_HOST:802:$DORM_GATEWAY"
		host_header="$DORM_GATEWAY:802"
		profile="$TYPE1_TLS_PROFILE"
	fi
	encoded_ipv6="$(urlencode "$LOCAL_IPV6")" || return 11
	url="$base?callback=dr1003&login_method=1&user_account=$encoded_account&user_password=$encoded_password&wlan_user_ip=$encoded_ip&wlan_user_ipv6=$encoded_ipv6&wlan_user_mac=000000000000&wlan_ac_ip=&wlan_ac_name=&jsVersion=4.2.1&terminal_type=1&lang=zh-cn&v=$(request_id)&lang=zh"
	http_request "$url" "$referer" "$resolve" "$host_header" "$profile" || return 11
	parse_login_response
}

type2_login() {
	local username="$1" password="$2" encoded_user encoded_password base referer resolve url
	encoded_user="$(urlencode "$username")" || return 11
	encoded_password="$(urlencode "$password")" || return 11
	if [ "$CFG_COMPATIBILITY" = "legacy_http" ]; then
		base="http://$WIFI_GATEWAY/drcom/login"; referer="http://$WIFI_GATEWAY/"; resolve=""
	else
		base="https://wlgn.bjut.edu.cn/drcom/login"; referer="https://wlgn.bjut.edu.cn/"; resolve="wlgn.bjut.edu.cn:443:$WIFI_GATEWAY"
	fi
	url="$base?callback=dr1003&DDDDD=$encoded_user&upass=$encoded_password&0MKKey=123456&R1=0&R2=&R3=0&R6=0&para=00&v6ip=&terminal_type=1&lang=zh-cn&jsVersion=4.1&v=$(request_id)&lang=zh"
	http_request "$url" "$referer" "$resolve" "" "strict" || return 11
	parse_login_response
}

type3_login() {
	local username="$1" password="$2" account enc_account enc_password enc_ipv4 enc_ipv6 url
	OBSERVED_IPV6=""
	discover_lgn_ipv6 || OBSERVED_IPV6=""
	case "$username" in ,0,*) account="$username" ;; *) account=",0,$username" ;; esac
	enc_account="$(eportal_encrypt "$account")" || return 11
	enc_password="$(eportal_encrypt "$password")" || return 11
	enc_ipv4="$(eportal_encrypt "$LOCAL_IPV4")" || return 11
	enc_ipv6="$(eportal_encrypt "$OBSERVED_IPV6")" || return 11
	url="https://lgn.bjut.edu.cn:802/eportal/portal/login?callback=726427262623&login_method=27&user_account=$enc_account&user_password=$enc_password&wlan_user_ip=$enc_ipv4&wlan_user_ipv6=$enc_ipv6&wlan_user_mac=262626262626262626262626&wlan_vlan_id=26&wlan_ac_ip=&wlan_ac_name=&authex_enable=&jsVersion=2238243824&login_ip_type=26&terminal_type=25&lang=6c7e3b7578&program_index=79225954737327212323222f212e2723&page_index=755e577b7c4e27212323222f212e2320&encrypt=1&v=$(request_id)&lang=zh"
	# Never replay credential submission on another gateway after a timeout.
	http_request "$url" "https://lgn.bjut.edu.cn/" "lgn.bjut.edu.cn:802:$LGN_SELECTED_GATEWAY" "" "strict" "${LGN_SELECTED_FAMILY:-ipv4}" || return 11
	parse_login_response
}

portal_identity_signature() {
	printf '%s\n' "$DEVICE" "$DEVICE6" "$LOCAL_IPV4" "$LOCAL_IPV6" "$TRANSPORT" "$SSID" "$BSSID" | sha256sum | awk '{print $1}'
}

verify_before_login() {
	local protocol="$1" previous now
	previous="$(portal_identity_signature)"
	read_network_identity && [ "$(portal_identity_signature)" = "$previous" ] && validate_network_identity "$protocol" || {
		log_message warning '网络身份在认证前发生变化，已停止提交'; return 1;
	}
	now="$(date +%s)"
	if [ "$VERIFIED_PROTOCOL" != "$protocol" ] || [ "$VERIFIED_IDENTITY" != "$previous" ] || [ "$now" -lt "$VERIFIED_AT" ] || [ "$((now-VERIFIED_AT))" -gt 10 ]; then
		probe_protocol "$protocol" || return 1
		VERIFIED_PROTOCOL="$protocol"; VERIFIED_AT="$now"; VERIFIED_IDENTITY="$previous"
	fi
	# This is only a short-lived, in-process gateway fingerprint. The actual
	# credential request still checks TLS / the exact pin and binds its source.
}

login_protocol() {
	verify_before_login "$1" || return 11
	case "$1" in
		type1) type1_login "$2" "$3" ;;
		type2) type2_login "$2" "$3" ;;
		type3) type3_login "$2" "$3" ;;
		*) return 11 ;;
	esac
}

try_accounts() {
 local protocol="$1" section enabled username password account_protocol masked rc attempted=0 order allowed capacity=0 wait_time
	ACCOUNT_RETRY_AFTER=''
	order="${CFG_ACCOUNT_ORDER:-$ACCOUNT_SECTIONS}"
	if [ "${CFG_PREFER_FLOW:-0}" = 1 ] && [ -z "$CFG_ACCOUNT_ORDER" ] && [ -z "$MANUAL_ACCOUNT" ];then order="$(traffic_order_accounts "$order")";fi
	[ -z "$MANUAL_ACCOUNT" ] || order="$MANUAL_ACCOUNT"
	for section in $order; do
		case " $ACCOUNT_SECTIONS " in *" $section "*) ;; *) continue ;; esac
		if [ -z "$MANUAL_ACCOUNT" ] && [ -n "$CFG_ACCOUNT_ORDER" ]; then
			case " $CFG_ACCOUNT_ORDER " in *" $section "*) ;; *) continue ;; esac
		fi
		config_get_bool enabled "$section" enabled 1
		[ "$enabled" = "1" ] || [ "$section" = "$MANUAL_ACCOUNT" ] || continue
		config_get username "$section" username ""
		config_get password "$section" password ""
		config_get account_protocol "$section" login_type "auto"
		account_protocol="$(protocol_internal "$account_protocol")"
		[ -n "$username" ] && [ -n "$password" ] || continue
		[ "$account_protocol" = "auto" ] || [ "$account_protocol" = "$protocol" ] || continue
		if [ -z "$MANUAL_ACCOUNT" ] && account_rejection_active "$section" "$protocol" "$username" "$password"; then
			attempted=1
			if [ -z "$ACCOUNT_RETRY_AFTER" ] || [ "$REJECTION_WAIT" -lt "$ACCOUNT_RETRY_AFTER" ];then ACCOUNT_RETRY_AFTER="$REJECTION_WAIT";fi
			log_message info "账号 $(mask_username "$username") 暂不可用，跳过本次自动登录（${REJECTION_WAIT} 秒后可重试）"
			password='';continue
		fi
		if ! account_reserve "$section"; then capacity=1; password=''; log_message notice "账号 $username 已达到并发上限，尝试备用账号"; continue; fi
		attempted=1
		masked="$(mask_username "$username")"
		log_message notice "正在通过 $(protocol_name "$protocol") 尝试账号 $masked"
		LOGIN_FAILURE_MESSAGE='';login_protocol "$protocol" "$username" "$password"
		rc=$?
		LOGIN_FAILURE_MESSAGE="$(login_failure_message "$username" "$password" "$LOGIN_FAILURE_MESSAGE")"
		if [ "$rc" = 10 ];then
			account_reject "$section" "$protocol" "$username" "$password" || log_message warning '无法保存账号冷却状态'
			[ -n "$ACCOUNT_RETRY_AFTER" ] && [ "$ACCOUNT_RETRY_AFTER" -le "$CFG_CREDENTIAL_COOLDOWN" ] || ACCOUNT_RETRY_AFTER="$CFG_CREDENTIAL_COOLDOWN"
		fi
		password=""
		[ "$rc" = 0 ] || account_release
		case "$rc" in
			0) account_clear_rejection "$section";SELECTED_ACCOUNT="$masked"; return 0 ;;
			10) log_message notice "账号 $masked 被认证网关拒绝：${LOGIN_FAILURE_MESSAGE:-网关未提供原因}；尝试下一个账号" ;;
			13) return 13 ;;
			*) [ -z "$LOGIN_FAILURE_MESSAGE" ] || log_message warning "认证暂未完成：$LOGIN_FAILURE_MESSAGE";return 11 ;;
		esac
	done
	[ "$capacity" != 1 ] || return 14
	[ "$attempted" = "1" ] && return 10
	return 12
}

calculate_backoff() {
	local failures="$1" delay="$CFG_INTERVAL" count=1
	while [ "$count" -lt "$failures" ] && [ "$delay" -lt "$CFG_MAX_BACKOFF" ]; do
		delay=$((delay * 2))
		[ "$delay" -gt "$CFG_MAX_BACKOFF" ] && delay="$CFG_MAX_BACKOFF"
		count=$((count + 1))
	done
	printf '%s' "$delay"
}

run_once_impl() {
	local now rc failures delay offline_count requested_user internet_ok=0 portal_rc=1 explicit_auth=0
	if [ -f "$STATE_DIR/paused-$UPLINK_ID" ] && [ "$FORCE" != 1 ]; then return 0; fi
	SESSION_STATE=unknown; OBSERVED_ACCOUNT=""; OBSERVED_IPV6=""; PROBE4=unknown; PROBE6=unknown
	VERIFIED_PROTOCOL=""; VERIFIED_AT=0; VERIFIED_IDENTITY=""
	ROUTE4=unknown; ROUTE6=unknown
	[ "$FORCE" != 1 ] || [ -z "$MANUAL_ACCOUNT" ] || explicit_auth=1
	write_phase "正在核对上游地址"
	read_network_identity
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if [ "$rc" -eq 2 ]; then
			write_status "blocked" "上游接口 IPv4 不属于已知校园网网段，未发送凭据" "" "" 0 0 0
			log_message error "上游接口地址不属于已知校园网网段，登录已阻止"
		else
			write_status "waiting_interface" "等待已配置的上游接口及校园网地址" "" "" 0 0 0
		fi
		return 1
	fi
	log_message info "开始检测：网络=${CFG_NETWORK}，IPv4=${LOCAL_IPV4}，事件=$EVENT"
	if ! acquire_source_lock; then
		[ -s "$STATE_FILE" ] || write_status busy "此物理出口正在检测，请稍候" "" "" 0 0 0
		return 75
	fi
	write_phase "正在确认出口路由"
	if ! ensure_uplink_routes; then
		write_status busy '出口路由正在被其他上游更新，请稍候重试' "$RUNTIME_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0
		return 75
	fi
	sync_mwan_rules || log_message error "mwan3 出口规则更新失败，请核对路由设置"
	load_runtime_state
	if ! curl_supports_ifhost && { [ "$CFG_MWAN3" != 1 ] || [ ! -r "$MWAN_WRAPPER" ]; }; then
		write_status blocked "当前 curl 无法同时指定设备和源地址，请升级 curl 或安装 mwan3" "$RUNTIME_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0
		return 1
	fi
	SELECTED_PROTOCOL=""
	if [ "$FORCE" != 1 ] || { [ "$TRANSPORT" = wifi ] && [ "$CFG_LOGIN_TYPE" = auto ] && [ -z "$MANUAL_ACCOUNT" ] && [ -z "$RUNTIME_PROTOCOL" ]; }; then
		write_phase "正在检测 IPv4 / IPv6 连通性"
		online_check && internet_ok=1
	fi
	# Known dormitory uplinks must consult online_list even when an individual
	# public target is reachable before authentication.
	if [ "$explicit_auth" = 1 ] || [ "$internet_ok" = 0 ] || [ "$CFG_LOGIN_TYPE" != auto ] || [ -n "$RUNTIME_PROTOCOL" ] || [ "$TRANSPORT" = ethernet ]; then
		write_phase "正在确认认证会话"
		detect_protocol; portal_rc=$?
		if [ "$portal_rc" = 0 ]; then read_portal_session "$SELECTED_PROTOCOL"; fi
		log_message info "认证网关：$(protocol_name "${SELECTED_PROTOCOL:-unknown}")，会话=$SESSION_STATE"
	fi
	if [ "$FORCE" = 1 ] && [ "$MANUAL_ACTION" = login ] && [ -n "$MANUAL_ACCOUNT" ] && [ -n "$RUNTIME_ACCOUNT" ] && [ "$SESSION_STATE" = online ]; then
		config_get requested_user "$MANUAL_ACCOUNT" username ''
		[ "${requested_user%@campus}" = "${RUNTIME_ACCOUNT%@campus}" ] || MANUAL_ACTION=switch
	fi
	if [ "$FORCE" = 1 ] && [ "$MANUAL_ACTION" != login ]; then
		if [ "$MANUAL_ACTION" = switch ] && ! account_reserve "$MANUAL_ACCOUNT"; then
			write_status account_busy '所选账号已达到并发上限，保留当前登录' "$RUNTIME_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0; return 1
		fi
		: >"$STATE_DIR/paused-$UPLINK_ID"
		if [ "$portal_rc" != 0 ] || ! validate_network_identity "$SELECTED_PROTOCOL"; then
			write_status logout_failed '无法确认当前认证网关，自动登录已暂停' '' "$RUNTIME_ACCOUNT" 0 0 0; return 1
		fi
		if [ "$SESSION_STATE" != offline ]; then
			write_phase '正在注销当前账号'
			if ! logout_protocol "$SELECTED_PROTOCOL"; then
				write_status logout_failed '注销结果待确认，自动登录已暂停；请刷新后重试' "$SELECTED_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0; return 1
			fi
		fi
		if [ "$MANUAL_ACTION" = logout ]; then
			account_release
			write_status logged_out '已注销，自动登录已暂停；点击登录可恢复' "$SELECTED_PROTOCOL" '' 0 0 0; return 0
		fi
		rm -f "$STATE_DIR/paused-$UPLINK_ID"; SESSION_STATE=offline; explicit_auth=1
	elif [ "$FORCE" = 1 ]; then
		rm -f "$STATE_DIR/paused-$UPLINK_ID"
		if [ "$SESSION_STATE" = online ] && [ -z "$MANUAL_ACCOUNT" ]; then online_check && internet_ok=1; fi
	fi
	if [ "$SESSION_STATE" = online ] && [ "$explicit_auth" = 0 ]; then
		if [ "$internet_ok" = 1 ]; then
			write_status online "认证会话有效，互联网连接正常" "$SELECTED_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0
		else
			write_status authenticated_limited "认证会话有效，外网探测暂未通过；保留当前登录" "$SELECTED_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0
		fi
		return 0
	fi
	if [ "$internet_ok" = 1 ] && [ "$SESSION_STATE" != offline ] && [ "$explicit_auth" = 0 ]; then
		write_status online "互联网连接正常" "${SELECTED_PROTOCOL:-$RUNTIME_PROTOCOL}" "$RUNTIME_ACCOUNT" 0 0 0
		return 0
	fi
	if [ "$FORCE" != 1 ] && [ "$SESSION_STATE" = unknown ]; then
		case "$RUNTIME_STATE" in online|authenticated_limited|login_accepted)
			write_status probe_uncertain "外网探测未通过，认证状态待确认；保留当前登录" "${SELECTED_PROTOCOL:-$RUNTIME_PROTOCOL}" "$RUNTIME_ACCOUNT" 0 0 0
			return 1 ;;
		probe_uncertain)
			write_status probe_uncertain "外网探测未通过，认证状态待确认；保留当前登录" "${SELECTED_PROTOCOL:-$RUNTIME_PROTOCOL}" "$RUNTIME_ACCOUNT" 0 0 0
			return 1 ;;
		esac
	fi
	now="$(date +%s)"
	if [ "$FORCE" != "1" ] && [ "$RUNTIME_NEXT_ATTEMPT" -gt "$now" ]; then
		write_status "cooldown" "当前仍离线，等待下一次安全重试" "" "" "$RUNTIME_NEXT_ATTEMPT" "$RUNTIME_FAILURES" "$RUNTIME_OFFLINE_COUNT"
		return 1
	fi
	offline_count=$((RUNTIME_OFFLINE_COUNT + 1))
	if [ "$FORCE" != "1" ] && [ "$offline_count" -lt "$CFG_OFFLINE_CONFIRMATIONS" ]; then
		write_status "offline_suspected" "首次离线检测，等待复核以避免瞬时误判" "" "" 0 "$RUNTIME_FAILURES" "$offline_count"
		return 1
	fi

	rc="$portal_rc"
	if [ "$rc" -ne 0 ]; then
		failures=$((RUNTIME_FAILURES + 1))
		delay="$(calculate_backoff "$failures")"
		if [ "$rc" -eq 2 ]; then
			write_status "portal_not_ready" "已发现校园网门户，但安全登录条件尚未满足" "" "" 0 "$failures" "$offline_count" "$delay"
		else
			write_status "portal_not_found" "未检测到与上游接口匹配的校园网认证门户" "" "" 0 "$failures" "$offline_count" "$delay"
		fi
		return 1
	fi
	if ! validate_network_identity "$SELECTED_PROTOCOL"; then
		write_status "blocked" "网络身份校验未通过，未发送凭据；请核对传输类型、SSID/BSSID 与安全模式" "$SELECTED_PROTOCOL" "" 0 0 "$offline_count"
		log_message error "网络身份校验未通过，已阻止 $SELECTED_PROTOCOL 凭据请求"
		return 1
	fi

	write_phase "正在提交认证"
	try_accounts "$SELECTED_PROTOCOL"
	rc=$?
	case "$rc" in
		0)
			log_message notice "$SELECTED_PROTOCOL 认证网关已接受账号 $SELECTED_ACCOUNT"
			write_status login_accepted '网关已受理登录，正在复核联网' "$SELECTED_PROTOCOL" "$SELECTED_ACCOUNT" 0 0 0
			write_phase '正在复核 IPv4 / IPv6 联网'
			online_check; rc=$?
			read_portal_session "$SELECTED_PROTOCOL"
			if [ "$rc" != 0 ] && [ "$SESSION_STATE" != online ] && [ "$CFG_POST_LOGIN_DELAY" -gt 0 ]; then
				sleep "$CFG_POST_LOGIN_DELAY"; online_check; rc=$?; read_portal_session "$SELECTED_PROTOCOL"
			fi
			if [ "$rc" = 0 ] && [ "$SESSION_STATE" != offline ]; then
				write_status "online" "认证网关已受理登录，外网连接正常" "$SELECTED_PROTOCOL" "${OBSERVED_ACCOUNT:-$SELECTED_ACCOUNT}" 0 0 0
			elif [ "$SESSION_STATE" = online ]; then
				write_status authenticated_limited "认证会话有效，外网探测暂未通过；保留当前登录" "$SELECTED_PROTOCOL" "${OBSERVED_ACCOUNT:-$SELECTED_ACCOUNT}" 0 0 0
			else
				write_status "login_accepted" "认证网关已接受登录，等待互联网连通性复核" "$SELECTED_PROTOCOL" "$SELECTED_ACCOUNT" 0 0 "$offline_count" "$CFG_INTERVAL"
			fi
			return 0
			;;
		13)
			# An account may be online on another uplink. Confirm this source
			# independently; never invent a session from the generic message.
			read_portal_session "$SELECTED_PROTOCOL"
			online_check; rc=$?
			if [ "$SESSION_STATE" = offline ]; then
				failures=$((RUNTIME_FAILURES + 1)); delay="$(calculate_backoff "$failures")"
				write_status request_failed "网关提示已有登录，当前出口仍待认证；请核对账号分配" "$SELECTED_PROTOCOL" "" 0 "$failures" "$offline_count" "$delay"
				return 1
			elif [ "$rc" = 0 ]; then
				write_status online "当前出口外网连接正常" "$SELECTED_PROTOCOL" "${OBSERVED_ACCOUNT:-$RUNTIME_ACCOUNT}" 0 0 0
			elif [ "$SESSION_STATE" = online ]; then
				write_status authenticated_limited "认证会话有效，外网探测暂未通过；保留当前登录" "$SELECTED_PROTOCOL" "${OBSERVED_ACCOUNT:-$RUNTIME_ACCOUNT}" 0 0 0
			else
				write_status probe_uncertain "网关提示已有登录，当前出口状态待确认；稍后复核" "$SELECTED_PROTOCOL" "$RUNTIME_ACCOUNT" 0 0 0
				return 1
			fi
			return 0 ;;
		10)
			write_status "auth_rejected" "所有适用账号暂不可用；等待冷却后重试" "$SELECTED_PROTOCOL" "" 0 1 "$offline_count" "${ACCOUNT_RETRY_AFTER:-$CFG_CREDENTIAL_COOLDOWN}"
			log_message error "$SELECTED_PROTOCOL 的所有适用账号均被认证网关拒绝"
			return 1
			;;
		12)
			write_status "no_account" "没有适用于已检测协议的已启用账号" "$SELECTED_PROTOCOL" "" 0 0 "$offline_count"
			return 1
			;;
		14)
			write_status account_busy '适用账号均已达到并发上限，请选择其他账号或调整上限' "$SELECTED_PROTOCOL" '' 0 0 "$offline_count"; return 1;;
		*)
			failures=$((RUNTIME_FAILURES + 1))
			delay="$(calculate_backoff "$failures")"
			write_status "request_failed" "认证请求失败或返回结果不明确；为避免重复登录，将稍后重试" "$SELECTED_PROTOCOL" "" 0 "$failures" "$offline_count" "$delay"
			return 1
			;;
	esac
}

run_once_locked() {
 local rc first deadline FORCE="$FORCE" MANUAL_ACCOUNT="$MANUAL_ACCOUNT" MANUAL_ACTION="$MANUAL_ACTION" EVENT="$EVENT" OPERATION_ID=''
	acquire_lock || return 75
	if [ -f "$STATE_DIR/manual-$UPLINK_ID" ]; then
		first="$(sed -n '1p' "$STATE_DIR/manual-$UPLINK_ID")"
		case "$first" in login|logout|switch) MANUAL_ACTION="$first"; MANUAL_ACCOUNT="$(sed -n '2p' "$STATE_DIR/manual-$UPLINK_ID")";; *) MANUAL_ACCOUNT="$first";; esac
		[ -z "$MANUAL_ACCOUNT" ] || valid_section "$MANUAL_ACCOUNT" || { release_lock; return 2; }
		FORCE=1; EVENT=manual
		OPERATION_ID="$(sed -n '3p' "$STATE_DIR/manual-$UPLINK_ID")"
		rm -f "$STATE_DIR/manual-$UPLINK_ID"
		if [ -n "$OPERATION_ID" ]; then
			deadline="$(json_file_value "$STATE_DIR/operation-$UPLINK_ID.json" '@.deadline')"
			if is_uint "$deadline" && [ "$deadline" -le "$(date +%s)" ]; then operation_update timeout '排队超时，未继续提交认证'; release_lock; return 1; fi
		fi
	fi
	if [ -z "$OPERATION_ID" ] && [ "$(json_file_value "$STATE_DIR/operation-$UPLINK_ID.json" '@.state')" = verifying ]; then
		OPERATION_ID="$(json_file_value "$STATE_DIR/operation-$UPLINK_ID.json" '@.id')"
	fi
	prepare_work_dir || { release_lock; return 1; }
	run_once_impl
	rc=$?
	rm -f -- "$STATE_DIR/phase-$UPLINK_ID"
	rm -rf -- "$WORK_DIR"
	WORK_DIR=""
	if [ "$SOURCE_LOCK_HELD" = 1 ]; then rm -rf -- "$SOURCE_LOCK"; SOURCE_LOCK_HELD=0; fi
	release_lock
	if [ "$rc" = 75 ] && [ -n "$OPERATION_ID" ]; then
		operation_update queued '等待出口检查结束'
		printf '%s\n%s\n%s\n' "$MANUAL_ACTION" "$MANUAL_ACCOUNT" "$OPERATION_ID" >"$STATE_DIR/manual-$UPLINK_ID"
		return 75
	fi
	# A manual request arriving during a periodic check runs immediately after
	# that check, instead of waiting another full daemon interval.
	if [ -f "$STATE_DIR/manual-$UPLINK_ID" ]; then run_once_locked; return $?; fi
	return "$rc"
}

run_daemon() {
	local rc
	while :; do
		run_all_uplinks || rc=$?
		if [ "${rc:-0}" -ne 0 ] && [ "${rc:-0}" -ne 1 ] && [ "${rc:-0}" -ne 75 ]; then
			log_message error "检查循环异常退出，代码 ${rc:-1}"
		fi
		rc=0
		billing_monitor_start
		sleep "$CFG_INTERVAL" &
		SLEEP_PID=$!
		wait "$SLEEP_PID" 2>/dev/null || true
		SLEEP_PID=""
	done
}

print_status() {
	print_status_file "$STATE_FILE" "$UPLINK_ID"
}

main() {
	local command="${1:-}" section="${2:-}"
	. "$LIB_DIR/uplinks.sh" || return 2
	. "$LIB_DIR/mwan.sh" || return 2
	. "$LIB_DIR/routing.sh" || return 2
	case "$command" in
		setup) prepare_router_identity && { load_configuration && prepare_log_destination; }; return $?;;
		status)
			load_configuration || return 2
			if [ -n "$section" ]; then select_uplink "$section" || return 2; print_status;
			elif [ "$UPLINK_CONFIGURED" = 1 ]; then print_all_status; else print_status; fi
			return 0 ;;
		version) printf '%s\n' "$VERSION"; return 0 ;;
		-h|--help|help|'') usage; [ -n "$command" ]; return $? ;;
		cleanup)
			CFG_MANAGED_ROUTES=0; CFG_MWAN3=0; UPLINK_SECTIONS=""
			prune_uplink_routes
			prune_mwan_rules
			return $? ;;
		check-config|daemon|once|manual|logout|switch) ;;
		*) usage >&2; return 2 ;;
	esac
	validate_configuration || return 2
	if [ -n "$section" ]; then select_uplink "$section" || return 2; fi
	MANUAL_ACCOUNT="${3:-}"
	[ -z "$MANUAL_ACCOUNT" ] || { valid_section "$MANUAL_ACCOUNT" && { [ "$command" = manual ] || [ "$command" = switch ]; }; } || return 2
	[ "$command" != switch ] || [ -n "$MANUAL_ACCOUNT" ] || return 2
	if [ "$command" = "check-config" ]; then
		printf 'Configuration is valid (enabled=%s, accounts=%s).\n' "$CFG_ENABLED" "$(printf '%s\n' $ACCOUNT_SECTIONS | sed '/^$/d' | wc -l)"
		return 0
	fi
	[ "$CFG_ENABLED" = "1" ] || [ "$command" = manual ] || [ "$command" = logout ] || [ "$command" = switch ] || {
		printf 'bjut-autologin is disabled in UCI.\n' >&2
		return 3
	}
	case "$command" in
		daemon) EVENT="periodic"; run_daemon ;;
		once) EVENT="${BJUT_EVENT:-manual_once}"; if [ -n "$section" ]; then run_once_locked; else run_all_uplinks; fi ;;
		manual) EVENT="manual"; FORCE=1; FORCE_COMMAND=manual; if [ -n "$section" ]; then run_once_locked; else run_all_uplinks; fi ;;
		logout|switch) [ -n "$section" ] || return 2; EVENT=manual; FORCE=1; MANUAL_ACTION="$command"; run_once_locked;;
	esac
}

[ ! -r "$LIB_DIR/uplinks.sh" ] || . "$LIB_DIR/uplinks.sh"
. "$LIB_DIR/logging.sh" || exit 2
. "$LIB_DIR/session-actions.sh" || exit 2
. "$LIB_DIR/pushplus.sh" || exit 2
. "$LIB_DIR/operations.sh" || exit 2
. "$LIB_DIR/coordination.sh" || exit 2
. "$LIB_DIR/billing-monitor.sh" || exit 2
. "$LIB_DIR/traffic.sh" || exit 2
. "$LIB_DIR/traffic-history.sh" || exit 2
. "$LIB_DIR/maintenance.sh" || exit 2

if [ "${BJUT_SOURCE_ONLY:-0}" != "1" ]; then
	main "$@"
fi
