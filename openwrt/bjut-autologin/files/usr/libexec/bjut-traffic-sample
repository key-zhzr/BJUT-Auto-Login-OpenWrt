#!/bin/sh
umask 077
BJUT_SOURCE_ONLY=1
BJUT_SELF="${BJUT_SELF:-/usr/sbin/bjut-autologin}"
. "$BJUT_SELF" || exit 1
. "$LIB_DIR/billing.sh" || exit 1
if [ "${1:-}" = --identities ];then
 load_configuration && traffic_identity_prepare
 exit $?
fi
valid_section "$1" || exit 2
if is_uint "${BJUT_TRAFFIC_SAMPLE_AT:-}" && [ "$((BJUT_TRAFFIC_SAMPLE_AT-$(date +%s)))" -gt 10 ];then
 preparation_pause "${BJUT_PREPARE_SLOT:-0}" || exit 1
fi
load_configuration || exit 1
TRAFFIC_ONLY_ACCOUNT="$1"
account_metadata "$1" || exit 1
key="$ACCOUNT_KEY"
if is_uint "${BJUT_TRAFFIC_ROUND:-}";then printf '0' >"$STATE_DIR/traffic/$key-next";fi
trap 'read -r owner stamp <"$STATE_DIR/traffic-jobs/$key";[ "$owner" != "$$" ] || rm -f "$STATE_DIR/traffic-jobs/$key";cleanup_runtime' 0
traffic_collect
