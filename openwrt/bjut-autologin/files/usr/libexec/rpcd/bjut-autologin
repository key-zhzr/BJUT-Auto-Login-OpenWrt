#!/bin/sh
# SPDX-License-Identifier: MIT
# rpcd checks the caller's session/ACL before executing these named methods.
if [ "$1" = list ]; then
	printf '%s\n' '{"status":{},"dashboard":{},"logout":{"uplink":"","account":""},"switch_account":{"uplink":"","account":""},"accounts":{},"ports":{},"logs":{},"settings":{},"maintenance_info":{},"maintenance_start":{"action":"","prepared":"","backup":""},"maintenance_poll":{"ticket":""},"billing_cached":{},"traffic":{},"pushplus_status":{},"pushplus_test":{},"save_settings":{"enabled":"","transport":"","login_type":"","compatibility":"","strict_network":"","expected_ssid":"","expected_bssid":"","interval":"","timeout":"","offline_confirmations":"","max_backoff":"","credential_cooldown":"","post_login_delay":"","online_url":"","online_code":"","managed_routes":"","mwan3":"","log_level":"","log_target":"","log_directory":"","log_web":"","log_max_kb":"","pushplus_enabled":"","pushplus_token":"","pushplus_topic":"","pushplus_online":"","pushplus_failure":"","pushplus_delay":"","pushplus_interval":"","prefer_remaining_flow":"","traffic_monitor":"","traffic_scope":"","billing_background":"","billing_interval":"","billing_alerts":"","balance_threshold":"","flow_threshold":""},"account_set":{"account":"","enabled":""},"login":{"uplink":"","account":""},"sync_accounts":{"payload":""},"billing_start":{"uplink":"","account":"","owner":""},"billing_details":{"uplink":"","account":"","owner":"","module":""},"billing_action":{"ticket":"","owner":"","operation":"","payload":""},"billing_poll":{"ticket":"","owner":""},"billing_captcha":{"ticket":"","owner":"","code":"","refresh":true},"account_save":{"account":"","username":"","password":"","enabled":"","login_type":"","max_sessions":""},"account_delete":{"account":""},"account_move":{"account":"","direction":""},"uplink_save":{"uplink":"","payload":""},"uplink_delete":{"uplink":""},"billing_records":{"uplink":"","account":"","owner":"","kind":"","start_date":"","end_date":"","year":"","page":""}}'
	exit 0
fi
[ "$1" = call ] || exit 2
BJUT_SOURCE_ONLY=1
BJUT_SELF="${BJUT_SELF:-/usr/sbin/bjut-autologin}"
. "$BJUT_SELF" || exit 1
. "$LIB_DIR/mwan.sh" || exit 1
. "$LIB_DIR/billing.sh" || exit 1
. "$LIB_DIR/routing.sh" || exit 1
. "$LIB_DIR/workbench.sh" || exit 1
mkdir -p "$STATE_DIR" && chmod 0700 "$STATE_DIR" || exit 1
REQUEST="$(mktemp "$STATE_DIR/rpc.XXXXXX")" || exit 1
trap 'rm -f -- "$REQUEST"; configuration_unlock' 0
head -c 131073 >"$REQUEST"
[ "$(wc -c <"$REQUEST" | tr -d ' \011\012\015')" -le 131072 ] || exit 2
load_configuration || exit 1
. "$JSHN_SH"

reply() {
	json_init
	json_add_string state "$1"
	json_add_string message "$2"
	json_dump
}

request_value() { json_file_value "$REQUEST" "@.$1"; }
valid_ticket() { case "$1" in ''|*[!0-9a-f]*) return 1 ;; esac; [ "${#1}" = 32 ]; }
random_ticket() { "$CODEC_BIN" random16; }
owner_hash() { printf '%s' "$1" | sha256sum | awk '{print $1}'; }
uci_quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }

accounts_list() {
	local section user enabled present account_type comma="" limit item online file acct state session active_accounts=""
	for item in $UPLINK_SECTIONS; do
		file="$STATE_DIR/uplink-$item.json"
		[ -s "$file" ] || continue
		acct="$(json_file_value "$file" '@.account')"
		[ -n "$acct" ] || continue
		state="$(json_file_value "$file" '@.state')"
		session=""
		case "$state" in online|authenticated_limited|probe_uncertain|login_accepted) ;; *)
			session="$(json_file_value "$file" '@.session')";;
		esac
		if account_session_active "$state" "$session"; then
			active_accounts="${active_accounts}${active_accounts:+ }$acct"
		fi
	done
	printf '{"accounts":['
	for section in $ACCOUNT_SECTIONS; do
		config_get user "$section" username ""
		config_get_bool enabled "$section" enabled 1
		config_get present "$section" password ""
		[ -z "$present" ] || present=1
		json_init; json_add_string id "$section"; json_add_string user "$user"
		json_add_int enabled "$enabled"; json_add_int hasPassword "${present:-0}"
		config_get account_type "$section" login_type auto; json_add_string loginType "$(protocol_name "$account_type")"
		config_get limit "$section" max_sessions 0; valid_range "$limit" 0 32 || limit=0
		online=0
		for item in $active_accounts; do
			[ "$item" != "$user" ] || online=$((online+1))
		done
		json_add_int maxSessions "$limit"; json_add_int onlineCount "$online"
		printf '%s' "$comma"; comma=,; json_dump
	done
	printf ']}\n'
}

sync_accounts() {
	local payload stage index=0 user password enabled section existing original count=0 result=0 is_new seen="" package newfile
	configuration_lock || { reply error "另一项设置正在保存，请稍后重试"; return; }
	payload="$STATE_DIR/accounts.$$.json"
	request_value payload >"$payload"
	stage="$(mktemp -d "$STATE_DIR/config.XXXXXX")" || return 1
	original="${BJUT_CONFIG_DIR:-/etc/config}/bjut-autologin"
	package="$(random_ticket)"
	valid_ticket "$package" || { rm -rf "$stage" "$payload"; reply error "无法准备账号同步，请更新路由端"; return; }
	package="bjut_sync_$package"
	cp "$original" "$stage/$package" || { rm -rf "$stage" "$payload"; return 1; }
	cp "$original" "$stage/original"
	while [ "$index" -lt 32 ]; do
		user="$(json_file_value "$payload" "@.accounts[$index].user")"
		[ -n "$user" ] || break
		password="$(json_file_value "$payload" "@.accounts[$index].pass")"
		enabled="$(json_file_value "$payload" "@.accounts[$index].enabled")"
		case "$user" in *[!A-Za-z0-9_@.,-]*) result=1; break ;; esac
		[ "${#user}" -le 256 ] && [ -n "$password" ] && [ "${#password}" -le 4096 ] || { result=1; break; }
		case "$password" in *'
'*|*'
'*) result=1; break ;; esac
		case "$enabled" in true|1) enabled=1 ;; false|0) enabled=0 ;; *) result=1; break ;; esac
		case "|$seen|" in *"|$user|"*) result=1; break ;; esac
		seen="${seen}${seen:+|}$user"
		section=""; is_new=0
		for existing in $ACCOUNT_SECTIONS; do
			config_get existing_user "$existing" username ""
			[ "$existing_user" != "$user" ] || { section="$existing"; break; }
		done
		[ -n "$section" ] || { section="app_$(printf '%s' "$user" | sha256sum | cut -c1-16)"; is_new=1; }
		{
			[ "$is_new" != 1 ] || printf 'set %s.%s=account\n' "$package" "$section"
			printf 'set %s.%s.username=' "$package" "$section"; uci_quote "$user"; printf '\n'
			printf 'set %s.%s.password=' "$package" "$section"; uci_quote "$password"; printf '\n'
			printf 'set %s.%s.enabled=%s\n' "$package" "$section" "$enabled"
			[ "$is_new" != 1 ] || printf 'set %s.%s.login_type=auto\n' "$package" "$section"
			printf 'commit %s\n' "$package"
		} | "$UCI_BIN" -q -c "$stage" batch || { result=1; break; }
		[ "$("$UCI_BIN" -q -c "$stage" get "$package.$section.password")" = "$password" ] || { result=1; break; }
		password=""; count=$((count + 1)); index=$((index + 1))
	done
	[ "$count" -gt 0 ] && [ "$index" -lt 32 ] || result=1
	if [ "$result" = 0 ] && cmp -s "$stage/original" "$original"; then
		# Re-read UCI to ensure the staged values were accepted before replacement.
		"$UCI_BIN" -q -c "$stage" export "$package" >/dev/null &&
		newfile="$(mktemp "$original.bjut.XXXXXX")" && cp "$stage/$package" "$newfile" &&
		chmod 0600 "$newfile" && mv -f "$newfile" "$original" || result=1
	else result=1; fi
	"$UCI_BIN" -q -c "$stage" revert "$package" >/dev/null 2>&1 || true
	[ -z "$newfile" ] || rm -f "$newfile"
	rm -rf -- "$stage" "$payload"
	if [ "$result" = 0 ]; then
		# Reload the service without exposing credentials in process arguments.
		[ ! -x "${BJUT_INIT:-/etc/init.d/bjut-autologin}" ] || "${BJUT_INIT:-/etc/init.d/bjut-autologin}" reload >/dev/null 2>&1
		reply ready "选定账号已同步，其他账号与上游分配已保留"
	else reply error "账号未同步；请检查内容，或等待路由配置保存后重试"; fi
}

launch_billing() {
	# Detach from rpcd's bounded request lifetime. The polling method only reads
	# the caller's ticket; it cannot run arbitrary commands or read arbitrary files.
	rm -f "$BILLING_JOB/worker-pid"
	printf '%s' "$(date +%s)" >"$BILLING_JOB/launched"
	/bin/sh "${BJUT_BILLING:-/usr/libexec/bjut-billing}" "$ticket" </dev/null >/dev/null 2>&1 &
}

billing_begin() {
	local owner uplink account ticket now old key kind start end year page module operation payload expectedAccount old_job
	owner="$(request_value owner)"
    if [ "${1:-}" = details ]; then
      module="$(request_value module)";case "$module" in services|devices|security|history|center);;*)reply error '计费模块无效';return;;esac
    fi
    if [ "${1:-}" = action ];then
      ticket_job && [ "$(json_file_value "$BILLING_JOB/result.json" '@.state')" = ready ] || { reply error '请先完成计费查询';return; }
      old_job="$BILLING_JOB";expectedAccount="$(json_file_value "$old_job/result.json" '@.account')"
      [ -n "$expectedAccount" ] || { reply error '请重新查询计费账号';return; }
      operation="$(request_value operation)";payload="$(request_value payload)"
      billing_validate_payload "$operation" "$payload" || { reply error '计费操作内容无效';return; }
    fi
    if [ "${1:-}" = records ]; then
        kind="$(request_value kind)"; start="$(request_value start_date)"; end="$(request_value end_date)"; year="$(request_value year)"; page="$(request_value page)"
        billing_validate_records "$kind" "$start" "$end" "$year" "$page" || { reply error "请检查记录类型、日期和页码"; return; }
    fi
	valid_ticket "$owner" && [ "$owner" != 00000000000000000000000000000000 ] || { reply error "请重新登录路由管理页面"; return; }
	uplink="$(request_value uplink)"; account="$(request_value account)"
    if [ -n "$old_job" ];then uplink="$(json_file_value "$old_job/request.json" '@.uplink')";account="$(json_file_value "$old_job/request.json" '@.account')";fi
	select_uplink "$uplink" || { reply error "所选上游不可用"; return; }
	[ -n "$account" ] || account=current
	case "$account" in current) ;; *) case " $ACCOUNT_SECTIONS " in *" $account "*) ;; *) reply error "所选账号不存在"; return ;; esac ;; esac
	mkdir -p "$STATE_DIR/billing"
	# Delete expired jobs, cookies and captured login forms from volatile storage.
	now="$(date +%s)"
	billing_collect_expired "$now"
	ticket="$(random_ticket)"
	valid_ticket "$ticket" || { reply error "无法准备计费查询，请更新路由端"; return; }
	BILLING_JOB="$STATE_DIR/billing/$ticket"; mkdir "$BILLING_JOB" || return 1
	owner="$(owner_hash "$owner")"; [ "${#owner}" = 64 ] || { rm -rf -- "$BILLING_JOB"; reply error "请重新安装路由端以补齐所需组件"; return; }
	printf '%s' "$owner" >"$BILLING_JOB/owner"
	printf '%s' "$now" >"$BILLING_JOB/created"
	json_init; json_add_string uplink "$uplink"; json_add_string account "$account"; json_add_string action begin
    [ -z "$module" ] || json_add_string module "$module"
    if [ -n "$operation" ];then
      json_add_string operation "$operation";json_add_string expectedAccount "$expectedAccount"
      printf '%s' "$payload" >"$BILLING_JOB/action.json"
      if [ "$operation" = disconnectSession ];then cp "$old_job/online.json" "$BILLING_JOB/selected-online.json" || { reply error '在线会话已过期，请刷新';return; };fi
    fi
    if [ "${1:-}" = records ]; then
        json_add_string kind "$kind"; json_add_string start_date "$start"; json_add_string end_date "$end"; json_add_string year "$year"; json_add_string page "$page"
    fi
	json_dump >"$BILLING_JOB/request.json"
	billing_progress loading 2 "正在准备计费查询"
	launch_billing
	json_init; json_add_string state loading; json_add_string ticket "$ticket"; json_dump
}

ticket_job() {
	ticket="$(request_value ticket)"; owner="$(request_value owner)"
	valid_ticket "$ticket" && valid_ticket "$owner" || return 1
	BILLING_JOB="$STATE_DIR/billing/$ticket"
	[ "$(cat "$BILLING_JOB/owner" 2>/dev/null)" = "$(owner_hash "$owner")" ] || return 1
	created="$(cat "$BILLING_JOB/created" 2>/dev/null)"
	is_uint "$created" && [ "$(($(date +%s) - created))" -le 600 ]
}

session_rows() {
	local index=0 comma="" value key row source prefix item
	source="$BILLING_JOB/online.json"
	[ -s "$source" ] || { printf '[]'; return; }
	prefix='@'
	[ -z "$(json_file_value "$source" '@.rows')" ] || prefix='@.rows'
	[ -z "$(json_file_value "$source" '@.data')" ] || prefix='@.data'
	printf '['
	while [ "$index" -lt 500 ]; do
		item="$prefix[$index]"
		[ -n "$(json_file_value "$source" "$item.sessionId")" ] || break
		json_init
		json_add_int sessionIndex "$index"
		for key in loginTime ip ipv6 mac useTime downFlow upFlow; do
			value="$(json_file_value "$source" "$item.$key")"
			[ "$key" != mac ] || value="$(billing_format_mac "$value")"
			[ "${#value}" -le 256 ] || value=""
			json_add_string "$key" "$value"
		done
		printf '%s' "$comma"; comma=,; json_dump
		index=$((index + 1))
	done
	printf ']'
}

case "$2" in
	status) print_all_status ;;
	dashboard) printf '{"status":'; print_all_status; printf ',"ports":'; workbench_ports; printf ',"accounts":'; accounts_list; printf '}\n';;
	accounts) accounts_list ;;
	ports) workbench_ports ;;
	logs) workbench_logs ;;
	settings) workbench_settings ;;
	billing_cached) billing_cached ;;
	traffic) traffic_cached ;;
	maintenance_info) maintenance_info ;;
	maintenance_start) maintenance_start ;;
	maintenance_poll) maintenance_poll ;;
	save_settings) workbench_save_settings ;;
	pushplus_status) workbench_pushplus_status ;;
	pushplus_test) workbench_pushplus_test ;;
	account_set) workbench_account_set ;;
	login|logout|switch_account)
		uplink="$(request_value uplink)"; account="$(request_value account)"
		select_uplink "$uplink" || { reply error "所选上游不可用"; exit 0; }
		case " $ACCOUNT_SECTIONS " in *" $account "*) ;; *) [ -z "$account" ] || { reply error "所选账号不存在"; exit 0; } ;; esac
		action=login
		case "$2" in logout) action=logout;; switch_account) action=switch; [ -n "$account" ] || { reply error '请先选择要切换的账号'; exit 0; };; esac
		operation_queue "$action" "$account" ;;
	sync_accounts) sync_accounts ;;
	billing_start) billing_begin ;;
    billing_records) billing_begin records ;;
    billing_details) billing_begin details ;;
    billing_action) billing_begin action ;;
    account_save) workbench_account_save ;;
    account_delete) workbench_account_delete ;;
    account_move) workbench_account_move ;;
    uplink_save) workbench_uplink_save ;;
    uplink_delete) workbench_uplink_delete ;;
	billing_poll)
		ticket_job || { reply error "查询已过期，请刷新"; exit 0; }
        if [ "$(json_file_value "$BILLING_JOB/result.json" '@.state')" = loading ];then
          worker="$(cat "$BILLING_JOB/worker-pid" 2>/dev/null)";launched="$(cat "$BILLING_JOB/launched" 2>/dev/null)"
          if { is_uint "$worker" && ! kill -0 "$worker" 2>/dev/null; } || { [ -z "$worker" ] && is_uint "$launched" && [ "$(($(date +%s)-launched))" -gt 10 ]; };then billing_progress error 100 '计费查询已中断，请刷新后重试';fi
        fi
		printf '{"result":'; cat "$BILLING_JOB/result.json"
		printf ',"sessionsAvailable":'; if [ -s "$BILLING_JOB/online.json" ]; then printf true; else printf false; fi
		printf ',"sessions":'; session_rows; printf '}\n' ;;
	billing_captcha)
		ticket_job || { reply error "查询已过期，请刷新"; exit 0; }
		[ "$(json_file_value "$BILLING_JOB/result.json" '@.state')" = captcha ] || { reply error "请等待当前查询完成"; exit 0; }
		code="$(request_value code)"; action=captcha
		if [ "$(request_value refresh)" = true ]; then action=refresh_captcha; else
			case "$code" in ''|*[!A-Za-z0-9]*) reply error "请填写图片中的验证码"; exit 0 ;; esac
			[ "${#code}" -le 12 ] || exit 2
		fi
		uplink="$(json_file_value "$BILLING_JOB/request.json" '@.uplink')"; account="$(json_file_value "$BILLING_JOB/request.json" '@.account')"
		json_init; json_add_string uplink "$uplink"; json_add_string account "$account"; json_add_string action "$action"; json_add_string code "$code"
        for key in kind start_date end_date year page module operation expectedAccount; do value="$(json_file_value "$BILLING_JOB/request.json" "@.$key")"; [ -z "$value" ] || json_add_string "$key" "$value"; done
		json_dump >"$BILLING_JOB/request.json"
		billing_progress loading 40 "正在核对验证码"; launch_billing
		reply loading "正在继续计费查询" ;;
	*) exit 2 ;;
esac
