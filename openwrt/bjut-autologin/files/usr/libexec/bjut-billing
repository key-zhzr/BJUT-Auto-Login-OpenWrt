#!/bin/sh
# SPDX-License-Identifier: MIT
BJUT_SOURCE_ONLY=1
BJUT_SELF="${BJUT_SELF:-/usr/sbin/bjut-autologin}"
. "$BJUT_SELF" || exit 1
. "$LIB_DIR/mwan.sh" || exit 1
. "$LIB_DIR/billing.sh" || exit 1
. "$LIB_DIR/routing.sh" || exit 1
case "$1" in ''|*[!0-9a-f]*) exit 2 ;; esac
[ "${#1}" = 32 ] || exit 2
lock="$STATE_DIR/billing/$1/lock"
mkdir "$lock" 2>/dev/null || exit 75
CACHE_LOCK=""
trap 'rm -rf -- "$lock"; [ -z "$CACHE_LOCK" ] || rm -rf -- "$CACHE_LOCK"; cleanup_runtime' 0
billing_worker "$1"
result=$?
if [ "$result" != 0 ] && [ "$(json_file_value "$STATE_DIR/billing/$1/result.json" '@.state')" = loading ]; then
	billing_progress error 100 "计费查询未完成，请检查上游设置后重试"
fi
exit "$result"
