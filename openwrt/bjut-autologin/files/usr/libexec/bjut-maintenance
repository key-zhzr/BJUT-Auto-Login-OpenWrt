#!/bin/sh
# SPDX-License-Identifier: MIT
BJUT_SOURCE_ONLY=1
BJUT_SELF="${BJUT_SELF:-/usr/sbin/bjut-autologin}"
. "$BJUT_SELF" || exit 1
load_configuration || exit 1
. "$JSHN_SH"
valid_ticket() { case "$1" in ''|*[!0-9a-f]*) return 1;; esac; [ "${#1}" = 32 ]; }
valid_ticket "$1" || exit 2
lock="$STATE_DIR/maintenance/$1/lock"
[ -d "$lock" ] || mkdir "$lock" || exit 1
printf '%s' "$$" >"$STATE_DIR/maintenance/$1/worker-pid"
trap 'rm -rf "$lock"; cleanup_runtime' 0
maintenance_worker "$1"; result=$?
if [ "$result" != 0 ] && [ "$(json_file_value "$MAINT_JOB/result.json" '@.state')" = loading ]; then maintenance_progress error '维护未完成，请检查网络、剩余空间及安装包兼容性' 100; fi
exit "$result"
