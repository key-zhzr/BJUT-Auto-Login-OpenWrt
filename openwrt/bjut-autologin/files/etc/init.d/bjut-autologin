#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/bjut-autologin
EXTRA_COMMANDS="manual status_json"
EXTRA_HELP="
	manual        Perform an immediate safe check/login
	status_json   Print the current JSON runtime status"

start_service() {
	local enabled traffic scope
	"$PROG" setup >/dev/null || return 1
	config_load bjut-autologin
	config_get_bool enabled main enabled 0
	config_get_bool traffic main traffic_monitor 0
	config_get scope main traffic_scope ""
	case "$scope" in local|all) ;; *)traffic=0;;esac
	[ "$enabled" = 1 ] || [ "$traffic" = 1 ] || return 0

	chmod 0600 /etc/config/bjut-autologin 2>/dev/null || true
	"$PROG" check-config >/dev/null || return 1

	if [ "$enabled" = 1 ];then
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 10
	procd_set_param file /etc/config/bjut-autologin
	procd_close_instance
	fi
	[ "$traffic" = 1 ] || return 0
	procd_open_instance traffic
	procd_set_param command /usr/libexec/bjut-traffic-monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 15
	procd_set_param env BJUT_TRAFFIC_REVISION=24
	procd_close_instance
}

stop_service() {
	local traffic
	config_load bjut-autologin
	config_get_bool traffic main traffic_monitor 0
	[ "$traffic" = 1 ] || { rm -rf /var/run/bjut-autologin/traffic-baselines; logger -t bjut-autologin "流量统计已暂停，恢复时重新建立基线"; }
	[ "${BJUT_RELOADING:-0}" = 1 ] || "$PROG" cleanup >/dev/null 2>&1
}

reload_service() {
	local enabled
	config_load bjut-autologin
	config_get_bool enabled main enabled 0
	BJUT_RELOADING="$enabled"
	# procd reconciles changed instances; the sampler reads its settings live.
	start
}

service_triggers() {
	procd_add_reload_trigger bjut-autologin
}

manual() {
	"$PROG" manual
}

status_json() {
	"$PROG" status
}
