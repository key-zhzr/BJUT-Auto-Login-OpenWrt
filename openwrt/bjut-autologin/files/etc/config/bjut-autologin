config service 'main'
	option enabled '0'
	option mwan3 '1'
	option managed_routes '1'
	option transport 'auto'
	option login_type 'auto'
	option compatibility 'secure'
	option interval '20'
	option timeout '3'
	option offline_confirmations '2'
	option max_backoff '300'
	option credential_cooldown '600'
	option post_login_delay '2'
	option online_url 'http://connect.rom.miui.com/generate_204'
	option online_code '204'
	option strict_network '1'
	option expected_ssid ''
	option expected_bssid ''
	option log_level 'info'
	option log_target 'system'
	option log_directory '/tmp/bjut-autologin-log'
	option log_web '0'
	option log_max_kb '256'
	option pushplus_enabled '0'
	option pushplus_token ''
	option pushplus_topic ''
	option pushplus_online '1'
	option pushplus_failure '1'
	option pushplus_delay '60'
	option pushplus_interval '3600'
	option traffic_monitor '0'
	option traffic_scope 'local'
	option traffic_minute_hours '48'
	option traffic_hour_days '90'
	option traffic_day_days '366'
	option traffic_storage_mb '2'
	option billing_background '0'
	option billing_interval '21600'
	option billing_alerts '1'
	option balance_threshold '5'
	option flow_threshold '5'

# Add one or more account sections. They are tried in file order. Keep this
